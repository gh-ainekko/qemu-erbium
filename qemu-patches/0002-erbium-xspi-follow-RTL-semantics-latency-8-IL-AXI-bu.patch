+static uint8_t erbium_read_byte(ErbiumXSPI *s)
+{
+    uint8_t b = 0;
+
+    switch (s->target) {
+    case ERB_TGT_SCCR:
+        if (s->is_reg) {
+            /* 65h: re-reads the same register every 4 bytes */
+            if (!s->burst_valid) {
+                stl_le_p(s->burst, erbium_xspi_sccr_read(s, s->cur_addr));
+                s->burst_len = 4;
+                s->burst_pos = 0;
+                s->burst_valid = true;
+            }
+            b = s->burst[s->burst_pos++];
+            if (s->burst_pos == s->burst_len) {
+                s->burst_valid = false;
+            }
+            return b;
+        }
+        /* fall through: memory-op view of SCCR */
+    case ERB_TGT_MRAM:
+    case ERB_TGT_REMOTE:
+    case ERB_TGT_NONE:
+        if (!s->burst_valid) {
+            erbium_read_burst_fetch(s);
+        }
+        if (s->burst_pos < s->burst_len) {
+            return s->burst[s->burst_pos++];
+        }
+        /* host reads past the AXI burst: zeros + underflow */
+        if (!(s->sccr[ERB_SCCR_INT_STATUS / 8] & ERB_INT_READ_UNDERFLOW)) {
+            trace_erbium_xspi_underflow(s->addr, s->burst_len);
+        }
+        erbium_set_int_status(s, ERB_INT_READ_UNDERFLOW);
+        return 0;
+
+    case ERB_TGT_SFDP:
+        if (!s->burst_valid) {
+            uint32_t a = s->cur_addr & ERB_SFDP_ADDR_MASK;
+            memset(s->burst, 0, 8);
+            if (!(a & 3)) {
+                for (unsigned i = 0; i < 4; i++) {
+                    if (a + i < erbium_sfdp_image_len) {
+                        s->burst[i] = erbium_sfdp_image[a + i];
+                    }
+                }
+            }
+            s->burst_len = s->sfdp_pad_quirk ? 8 : 4;
+            s->burst_pos = 0;
+            s->burst_valid = true;
+        }
+        b = s->burst[s->burst_pos++];
+        if (s->burst_pos == s->burst_len) {
+            s->burst_valid = false;
+            s->cur_addr = (s->cur_addr & ~ERB_SFDP_ADDR_MASK) |
+                          ((s->cur_addr + 4) & ERB_SFDP_ADDR_MASK);
+        }
+        return b;
+    }
+    return 0;
 }
 
