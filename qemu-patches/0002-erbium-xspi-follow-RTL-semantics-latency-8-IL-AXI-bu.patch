+/* xSPI -> CPU address translation done by the NoC for initiator S_XSPI */
+static uint64_t erbium_xspi_to_cpu(uint32_t xaddr)
+{
+    if (xaddr < 0x40000000u) {
+        return (uint64_t)xaddr + 0x40000000ull;
+    }
+    if (xaddr < 0x80000000u) {
+        return (uint64_t)xaddr - 0x3E000000ull;
+    }
+    return xaddr;
