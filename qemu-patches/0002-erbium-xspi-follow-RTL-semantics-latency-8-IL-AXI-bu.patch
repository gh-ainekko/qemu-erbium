+/* latency SCK cycles = 8 + CFG.InitialLatency (hb_decode_latency) */
+static unsigned erbium_latency_cycles(ErbiumXSPI *s)
+{
+    return 8 + ((s->sccr[ERB_SCCR_CFG / 8] & ERB_CFG_INITIAL_LATENCY_MASK) >>
+                ERB_CFG_INITIAL_LATENCY_SHIFT);
+}
+
 /*
- * Number of SSI byte transfers that make up the latency phase of a read.
- * Latency is counted in clock cycles (CFG.InitialLatency); the number of
- * bytes clocked through in that time depends on lanes and DTR.
+ * Number of SSI byte transfers that make up the latency phase: the SSI
+ * transport carries no clock, so latency cycles are converted to the number
+ * of bytes the host controller would clock through at the data rate.
  */
 static unsigned erbium_latency_bytes(ErbiumXSPI *s)
 {
-    unsigned cycles, lanes, bits;
+    unsigned bits;
 
     if (s->latency_bytes_override >= 0) {
         return s->latency_bytes_override;
     }
-    cycles = (s->sccr[ERB_SCCR_CFG / 8] & ERB_CFG_INITIAL_LATENCY_MASK) >>
-             ERB_CFG_INITIAL_LATENCY_SHIFT;
-    lanes = erbium_rate_lanes(s->data_rate);
-    bits = cycles * lanes * (erbium_rate_dtr(s->data_rate) ? 2 : 1);
+    bits = erbium_latency_cycles(s) * erbium_rate_lanes(s->data_rate) *
+           (erbium_rate_dtr(s->data_rate) ? 2 : 1);
     return DIV_ROUND_UP(bits, 8);
 }
 
+/* AXI read burst length in bytes (fn_hb_decode_len) */
+static unsigned erbium_read_burst_bytes(ErbiumXSPI *s)
+{
+    static const unsigned len[4] = { 128, 64, 16, 32 };
+    uint32_t cfg = s->sccr[ERB_SCCR_CFG / 8];
+
+    if (!(cfg & ERB_CFG_BURST_ENABLE)) {
+        return 8;
+    }
+    return len[cfg & ERB_CFG_BURST_LENGTH_MASK];
+}
