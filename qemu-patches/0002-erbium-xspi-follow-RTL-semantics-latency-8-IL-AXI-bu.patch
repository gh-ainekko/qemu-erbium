 hw/ssi/erbium-xspi.c         | 465 +++++++++++++++++++++--------------
 hw/ssi/trace-events          |   1 +
 include/hw/ssi/erbium-xspi.h |  50 ++--
 4 files changed, 311 insertions(+), 206 deletions(-)

