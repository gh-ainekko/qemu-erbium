diff --git a/include/hw/ssi/erbium-xspi.h b/include/hw/ssi/erbium-xspi.h
new file mode 100644
index 0000000..5aa7bc5
--- /dev/null
+++ b/include/hw/ssi/erbium-xspi.h
@@ -0,0 +1,149 @@
+/*
+ * Erbium xSPI target interface (JESD251 xSPI Profile 2.0 style device)
+ *
+ * Functional model of the host-visible xSPI interface of the Erbium chip:
+ * 16 MiB MRAM plus the chip's xSPI-visible register map, reached through
+ * JESD251C-style command sequences.  Lane width / DTR are modelled as
+ * logical protocol state; bytes still move through QEMU's SSI abstraction.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+#ifndef HW_SSI_ERBIUM_XSPI_H
+#define HW_SSI_ERBIUM_XSPI_H
+
+#include "hw/ssi/ssi.h"
+#include "chardev/char-fe.h"
+#include "system/hostmem.h"
+#include "qom/object.h"
+
+#define TYPE_ERBIUM_XSPI "erbium-xspi"
+OBJECT_DECLARE_SIMPLE_TYPE(ErbiumXSPI, ERBIUM_XSPI)
+
+#define ERBIUM_MRAM_SIZE        (16 * MiB)
+
+/* xSPI opcodes (Erbium TRM, "XSPI Datasheet") */
+#define ERB_OP_NOP              0x00
+#define ERB_OP_WRITE_MEM        0x02
+#define ERB_OP_READ_MEM         0x0B
+#define ERB_OP_SET_RATE         0x52
+#define ERB_OP_READ_SFDP        0x5A
+#define ERB_OP_READ_REG         0x65
+#define ERB_OP_WRITE_REG        0x71
+#define ERB_OP_RESET            0x99
+
+/* setRate encodings */
+enum ErbiumRate {
+    ERB_RATE_S1 = 0,
+    ERB_RATE_D1 = 1,
+    ERB_RATE_S4 = 4,
+    ERB_RATE_D4 = 5,
+    ERB_RATE_S8 = 6,
+    ERB_RATE_D8 = 7,
+    ERB_RATE_HB = 8,
+};
+
+/* SCCR (xSPI status/control/configuration registers), 64-bit stride */
+#define ERB_SCCR_ID0            0x00
+#define ERB_SCCR_ID1            0x08
+#define ERB_SCCR_CFG            0x10
+#define ERB_SCCR_XSPI_STATUS    0x18
+#define ERB_SCCR_XSPI_CONTROL   0x20
+#define ERB_SCCR_XSPI_RATES     0x28
+#define ERB_SCCR_INT_STATUS     0x30
+#define ERB_SCCR_SIZE           0x38
+#define ERB_SCCR_NREGS          (ERB_SCCR_SIZE / 8)
+
+/* CFG fields */
+#define ERB_CFG_BURST_LENGTH_MASK       0x3
+#define ERB_CFG_HYBRID_BURST            (1 << 2)
+#define ERB_CFG_FIXED_LATENCY           (1 << 3)
+#define ERB_CFG_INITIAL_LATENCY_SHIFT   4
+#define ERB_CFG_INITIAL_LATENCY_MASK    (0xf << 4)
+#define ERB_CFG_DEEP_PD                 (1 << 15)
+#define ERB_CFG_BURST_ENABLE            (1 << 16)
+#define ERB_CFG_ULTRA_DEEP_PD           (1 << 17)
+
+/* interrupt_status fields */
+#define ERB_INT_AXI_RESP_MASK           0x3
+#define ERB_INT_READ_UNDERFLOW          (1 << 2)
+#define ERB_INT_WRITE_OVERFLOW          (1 << 3)
+
+/* Backend protocol status codes (docs/protocol.md) */
+#define ERB_ST_OK       0
+#define ERB_ST_SLVERR   2
+#define ERB_ST_DECERR   3
+#define ERB_ST_BADREQ   0x100
+
+typedef enum {
+    ERB_PHASE_CMD = 0,
+    ERB_PHASE_EXT,
+    ERB_PHASE_ADDR,
+    ERB_PHASE_LATENCY,
+    ERB_PHASE_DATA,
+    ERB_PHASE_DONE,     /* command fully consumed, ignore until CS deassert */
+} ErbiumPhase;
+
+typedef enum {
+    ERB_TGT_NONE = 0,
+    ERB_TGT_MRAM,       /* local shared memory */
+    ERB_TGT_SCCR,       /* local register block */
+    ERB_TGT_SFDP,       /* local SFDP table */
+    ERB_TGT_REMOTE,     /* forwarded to backend (or built-in stub) */
+} ErbiumTarget;
+
+#define ERB_WORD_MAX 8
+
+struct ErbiumXSPI {
+    SSIPeripheral parent_obj;
+
+    /* configuration */
+    HostMemoryBackend *memdev;
+    CharFrontend chr;
+    uint8_t default_mode;       /* 2-bit strap: 0=HB 1=Octal 2=Quad 3=SPI */
+    int32_t latency_bytes_override; /* -1: derive from CFG/rates */
+    bool strict;                /* reject undefined-behaviour sequences */
+    bool ext_check;             /* verify opcode extension byte */
+
+    /* storage */
+    uint8_t *mram;              /* ERBIUM_MRAM_SIZE bytes */
+    uint8_t *mram_local;        /* allocated if no memdev */
+    uint8_t *stub_sysregs;      /* built-in stub when no backend: 0x02000000, 16 KiB */
+    uint8_t *stub_sram;         /* 0x0200C000, 4 KiB */
+    bool backend_connected;
+
+    /* SCCR */
+    uint32_t sccr[ERB_SCCR_NREGS];
+
+    /* protocol state */
+    uint8_t cmd_rate, addr_rate, data_rate;
+    uint8_t pending_rate[3];
+    bool rate_pending;
+
+    /* current transaction */
+    ErbiumPhase phase;
+    ErbiumPhase after_ext;      /* phase following the EXT byte */
+    ErbiumTarget target;
+    uint8_t opcode;
+    uint8_t ext;
+    uint32_t addr;
+    unsigned addr_bytes;
+    unsigned addr_got;
+    unsigned latency_bytes;
+    unsigned latency_got;
+    bool is_write;
+    unsigned word_size;         /* 4 for register ops, 8 for memory ops */
+    uint64_t cur_addr;          /* address of next data byte */
+    uint64_t bytes_done;
+    uint8_t word[ERB_WORD_MAX];
+    unsigned word_pos;
+    bool word_valid;            /* read: word[] holds fetched data */
+    uint8_t last_status;
+    bool reset_pending;
+    bool cmd_error;
+};
+
+/* helpers exported for tests */
+uint32_t erbium_xspi_sccr_read(ErbiumXSPI *s, unsigned offset);
+void erbium_xspi_sccr_write(ErbiumXSPI *s, unsigned offset, uint32_t val);
+
+#endif
