+/*
+ * Erbium xSPI target interface model
+ *
+ * See include/hw/ssi/erbium-xspi.h and docs/erbium-qemu-review.md in the
+ * erbium-emu repository for the architecture.
+ *
+ * Physical wiring being modelled: the host's OSPI controller talks to the
+ * Erbium xSPI target IP over CS/DQ[7:0]/RWDS.  Inside the chip that IP owns
+ * the SCCR register block (reached with Read/Write Register commands) and is
+ * an AXI4 initiator on the NIC (Read/Write Memory commands).  Here:
+ *   - MRAM is a host memory backend (shared mmap file) so a co-running
+ *     erbium_emu CPU model sees the same bytes;
+ *   - non-MRAM memory accesses are forwarded over a chardev socket to
+ *     erbium_emu, which models the NIC and its targets (docs/protocol.md);
+ *     without a chardev, a small built-in stub answers instead.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/ssi/erbium-xspi.h"
+#include "migration/vmstate.h"
+#include "exec/memory.h"
+#include "trace.h"
+
+extern const uint8_t erbium_sfdp_image[];
+extern const unsigned erbium_sfdp_image_len;
+
+/* ------------------------------------------------------------------ */
+/* Address maps                                                        */
+
+/* xSPI-visible map (TRM "xSPI Memory Map") -> CPU map (erbium-hal top.h) */
+typedef struct {
+    uint64_t xspi_base;
+    uint64_t size;
+    uint64_t cpu_base;
+    ErbiumTarget target;
+} ErbiumMapEntry;
+
+#define ERB_CPU_SYSREGS_BASE    0x02000000ull
+#define ERB_CPU_SRAM_BASE       0x0200C000ull
+#define ERB_CPU_MRAM_BASE       0x40000000ull
+#define ERB_CPU_CPUREGS_BASE    0x80000000ull
+
+static const ErbiumMapEntry erbium_xspi_map[] = {
+    { 0x00000000, ERBIUM_MRAM_SIZE, ERB_CPU_MRAM_BASE,      ERB_TGT_MRAM },
+    { 0x0E000000, 0x00016000,       0xFE000000ull,          ERB_TGT_REMOTE }, /* NIC cfg */
+    { 0x40000000, 0x00005000,       ERB_CPU_SYSREGS_BASE,   ERB_TGT_REMOTE }, /* sys/mram/i2c/qspi/uart regs */
+    { 0x40005000, 0x00001000,       ERB_CPU_SRAM_BASE,      ERB_TGT_REMOTE }, /* SRAM */
+    { 0x80000000, 0x01000000,       ERB_CPU_CPUREGS_BASE,   ERB_TGT_REMOTE }, /* CPU regs (ESR) */
+};
+
+static const ErbiumMapEntry *erbium_map_lookup(uint64_t xaddr)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(erbium_xspi_map); i++) {
+        const ErbiumMapEntry *e = &erbium_xspi_map[i];
+        if (xaddr >= e->xspi_base && xaddr < e->xspi_base + e->size) {
+            return e;
+        }
+    }
+    return NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* Backend (erbium_emu over chardev) and built-in stub                 */
+
+#define ERB_MSG_MAGIC   0x42524555u
+#define ERB_MSG_VERSION 1
+#define ERB_MSGOP_PING  1
+#define ERB_MSGOP_READ  2
+#define ERB_MSGOP_WRITE 3
+#define ERB_MSGOP_RESET 4
+
+typedef struct QEMU_PACKED {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t op;
+    uint32_t status;
+    uint32_t len;
+    uint64_t addr;
+} ErbMsgHdr;
+
+#define ERB_STUB_SYSREGS_SIZE   0x5000
+#define ERB_STUB_SRAM_SIZE      0x1000
+
+static int erbium_backend_xfer(ErbiumXSPI *s, uint16_t op, uint64_t addr,
+                               void *buf, uint32_t len, bool is_write)
+{
+    ErbMsgHdr hdr = {
+        .magic = cpu_to_le32(ERB_MSG_MAGIC),
+        .version = cpu_to_le16(ERB_MSG_VERSION),
+        .op = cpu_to_le16(op),
+        .status = 0,
+        .len = cpu_to_le32(is_write ? len : 0),
+        .addr = cpu_to_le64(addr),
+    };
+    ErbMsgHdr rsp;
+    uint32_t rlen, status;
+    int r;
+
+    if (!s->backend_connected) {
+        return ERB_ST_DECERR;
+    }
+    r = qemu_chr_fe_write_all(&s->chr, (uint8_t *)&hdr, sizeof(hdr));
+    if (r == sizeof(hdr) && is_write && len) {
+        r = qemu_chr_fe_write_all(&s->chr, buf, len);
+        r = (r == (int)len) ? sizeof(hdr) : -1;
+    }
+    if (r != sizeof(hdr)) {
+        goto lost;
+    }
+    r = qemu_chr_fe_read_all(&s->chr, (uint8_t *)&rsp, sizeof(rsp));
+    if (r != sizeof(rsp) || le32_to_cpu(rsp.magic) != ERB_MSG_MAGIC ||
+        le16_to_cpu(rsp.op) != (op | 0x8000)) {
+        goto lost;
+    }
+    rlen = le32_to_cpu(rsp.len);
+    status = le32_to_cpu(rsp.status);
+    if (rlen) {
+        if (!is_write && op == ERB_MSGOP_READ && rlen == len) {
+            r = qemu_chr_fe_read_all(&s->chr, buf, len);
+            if (r != (int)len) {
+                goto lost;
+            }
+        } else {
+            /* unexpected payload: drain */
+            g_autofree uint8_t *tmp = g_malloc(rlen);
+            if (qemu_chr_fe_read_all(&s->chr, tmp, rlen) != (int)rlen) {
+                goto lost;
+            }
+            if (op == ERB_MSGOP_PING && buf && rlen <= len) {
+                memcpy(buf, tmp, rlen);
+            }
+        }
+    } else if (!is_write && op == ERB_MSGOP_READ && status == ERB_ST_OK) {
+        status = ERB_ST_SLVERR;
+    }
+    trace_erbium_xspi_backend(op, addr, len, status);
+    return status;
+
+lost:
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "erbium-xspi: backend connection lost (op %u)\n", op);
+    s->backend_connected = false;
+    return ERB_ST_DECERR;
+}
+
+static int erbium_stub_access(ErbiumXSPI *s, uint64_t cpu_addr, void *buf,
+                              uint32_t len, bool is_write)
+{
+    uint8_t *base = NULL;
+    uint64_t off = 0;
+
+    if (cpu_addr >= ERB_CPU_SYSREGS_BASE &&
+        cpu_addr + len <= ERB_CPU_SYSREGS_BASE + ERB_STUB_SYSREGS_SIZE) {
+        base = s->stub_sysregs;
+        off = cpu_addr - ERB_CPU_SYSREGS_BASE;
+    } else if (cpu_addr >= ERB_CPU_SRAM_BASE &&
+               cpu_addr + len <= ERB_CPU_SRAM_BASE + ERB_STUB_SRAM_SIZE) {
+        base = s->stub_sram;
+        off = cpu_addr - ERB_CPU_SRAM_BASE;
+    } else {
+        return ERB_ST_DECERR;
+    }
+    if (is_write) {
+        memcpy(base + off, buf, len);
+    } else {
+        memcpy(buf, base + off, len);
+    }
+    return ERB_ST_OK;
+}
+
+static int erbium_remote_access(ErbiumXSPI *s, uint64_t cpu_addr, void *buf,
+                                uint32_t len, bool is_write)
+{
+    if (s->backend_connected) {
+        return erbium_backend_xfer(s, is_write ? ERB_MSGOP_WRITE : ERB_MSGOP_READ,
+                                   cpu_addr, buf, len, is_write);
+    }
+    return erbium_stub_access(s, cpu_addr, buf, len, is_write);
+}
+
+/* ------------------------------------------------------------------ */
+/* SCCR                                                                */
+
+static const uint32_t erbium_sccr_reset[ERB_SCCR_NREGS] = {
+    [ERB_SCCR_ID0 / 8]          = 0x00000002,   /* mgf_id = 2 (TRM: TBD) */
+    [ERB_SCCR_ID1 / 8]          = 0x00000000,
+    [ERB_SCCR_CFG / 8]          = 0x0000318A,   /* BurstLength=2, FixedLatency, InitialLatency=8, rsvd=1, DriveStrength=3 */
+    [ERB_SCCR_XSPI_STATUS / 8]  = 0,
+    [ERB_SCCR_XSPI_CONTROL / 8] = 0,
+    [ERB_SCCR_XSPI_RATES / 8]   = 0,
+    [ERB_SCCR_INT_STATUS / 8]   = 0,
+};
+
+static const uint32_t erbium_sccr_wmask[ERB_SCCR_NREGS] = {
+    [ERB_SCCR_ID0 / 8]          = 0x0000ffff,
+    [ERB_SCCR_ID1 / 8]          = 0x0000ffff,
+    [ERB_SCCR_CFG / 8]          = 0x000380f3,   /* rw: BurstLength, InitialLatency, DeepPD, BurstEnable, UltraDeepPD */
+    [ERB_SCCR_XSPI_STATUS / 8]  = 0,
+    [ERB_SCCR_XSPI_CONTROL / 8] = 0x00000003,
+    [ERB_SCCR_XSPI_RATES / 8]   = 0x00ffffff,
+    [ERB_SCCR_INT_STATUS / 8]   = 0,            /* read-to-clear */
+};
+
+uint32_t erbium_xspi_sccr_read(ErbiumXSPI *s, unsigned offset)
+{
+    unsigned idx = offset / 8;
+    uint32_t v;
+
+    if (offset >= ERB_SCCR_SIZE || (offset & 7)) {
+        return 0;
+    }
+    v = s->sccr[idx];
+    if (idx == ERB_SCCR_INT_STATUS / 8) {
+        s->sccr[idx] = 0;   /* rclr */
+    }
+    trace_erbium_xspi_sccr_read(offset, v);
+    return v;
+}
+
+void erbium_xspi_sccr_write(ErbiumXSPI *s, unsigned offset, uint32_t val)
+{
+    unsigned idx = offset / 8;
+
+    if (offset >= ERB_SCCR_SIZE || (offset & 7)) {
+        return;
+    }
+    trace_erbium_xspi_sccr_write(offset, val);
+    s->sccr[idx] = (s->sccr[idx] & ~erbium_sccr_wmask[idx]) |
+                   (val & erbium_sccr_wmask[idx]);
+}
+
+static void erbium_set_axi_error(ErbiumXSPI *s, int status)
+{
+    if (status == ERB_ST_OK) {
+        return;
+    }
+    trace_erbium_xspi_axi_error(s->opcode, s->cur_addr, status);
+    s->sccr[ERB_SCCR_INT_STATUS / 8] =
+        (s->sccr[ERB_SCCR_INT_STATUS / 8] & ~ERB_INT_AXI_RESP_MASK) |
+        (status & ERB_INT_AXI_RESP_MASK);
+}
+
+/* ------------------------------------------------------------------ */
+/* Rates / latency                                                     */
+
+static unsigned erbium_rate_lanes(uint8_t rate)
+{
+    switch (rate) {
+    case ERB_RATE_S1: case ERB_RATE_D1: return 1;
+    case ERB_RATE_S4: case ERB_RATE_D4: return 4;
+    default:                            return 8;
+    }
+}
+
+static bool erbium_rate_dtr(uint8_t rate)
+{
+    return rate == ERB_RATE_D1 || rate == ERB_RATE_D4 ||
+           rate == ERB_RATE_D8 || rate == ERB_RATE_HB;
+}
+
+static bool erbium_rate_valid(uint8_t rate)
+{
+    switch (rate) {
+    case ERB_RATE_S1: case ERB_RATE_D1: case ERB_RATE_S4: case ERB_RATE_D4:
+    case ERB_RATE_S8: case ERB_RATE_D8: case ERB_RATE_HB:
+        return true;
+    }
+    return false;
+}
+
+static bool erbium_is_spi_mode(ErbiumXSPI *s)
+{
+    return s->cmd_rate == ERB_RATE_S1;
+}
+
+static void erbium_apply_rates(ErbiumXSPI *s, uint8_t c, uint8_t a, uint8_t d)
+{
+    trace_erbium_xspi_rate_change(s->cmd_rate, s->addr_rate, s->data_rate, c, a, d);
+    s->cmd_rate = c;
+    s->addr_rate = a;
+    s->data_rate = d;
+    s->sccr[ERB_SCCR_XSPI_RATES / 8] = c | (a << 8) | (d << 16);
+}
+
+static void erbium_apply_default_mode(ErbiumXSPI *s)
+{
+    uint8_t r;
+
+    switch (s->default_mode & 3) {
+    case 0:  r = ERB_RATE_HB; break;
+    case 1:  r = ERB_RATE_D8; break;
+    case 2:  r = ERB_RATE_S4; break;
+    default: r = ERB_RATE_S1; break;
+    }
+    erbium_apply_rates(s, r, r, r);
+}
+
+/*
+ * Number of SSI byte transfers that make up the latency phase of a read.
+ * Latency is counted in clock cycles (CFG.InitialLatency); the number of
+ * bytes clocked through in that time depends on lanes and DTR.
+ */
+static unsigned erbium_latency_bytes(ErbiumXSPI *s)
+{
+    unsigned cycles, lanes, bits;
+
+    if (s->latency_bytes_override >= 0) {
+        return s->latency_bytes_override;
+    }
+    cycles = (s->sccr[ERB_SCCR_CFG / 8] & ERB_CFG_INITIAL_LATENCY_MASK) >>
+             ERB_CFG_INITIAL_LATENCY_SHIFT;
+    lanes = erbium_rate_lanes(s->data_rate);
+    bits = cycles * lanes * (erbium_rate_dtr(s->data_rate) ? 2 : 1);
+    return DIV_ROUND_UP(bits, 8);
+}
+
+/* ------------------------------------------------------------------ */
+/* Data path helpers                                                   */
+
+static void erbium_word_fetch(ErbiumXSPI *s)
+{
+    int st = ERB_ST_OK;
+
+    memset(s->word, 0xff, sizeof(s->word));
+    switch (s->target) {
+    case ERB_TGT_MRAM:
+        if (s->cur_addr + s->word_size <= ERBIUM_MRAM_SIZE) {
+            memcpy(s->word, s->mram + s->cur_addr, s->word_size);
+        } else {
+            /* crossed out of MRAM: re-resolve */
+            const ErbiumMapEntry *e = erbium_map_lookup(s->cur_addr);
+            if (!e || e->target != ERB_TGT_MRAM) {
+                st = ERB_ST_DECERR;
+            }
+        }
+        break;
+    case ERB_TGT_SCCR:
+        stl_le_p(s->word, erbium_xspi_sccr_read(s, s->cur_addr));
+        break;
+    case ERB_TGT_SFDP:
+        for (unsigned i = 0; i < s->word_size; i++) {
+            uint64_t a = s->cur_addr + i;
+            s->word[i] = a < erbium_sfdp_image_len ? erbium_sfdp_image[a] : 0xff;
+        }
+        break;
+    case ERB_TGT_REMOTE: {
+        const ErbiumMapEntry *e = erbium_map_lookup(s->cur_addr);
+        if (!e) {
+            st = ERB_ST_DECERR;
+        } else {
+            st = erbium_remote_access(s, e->cpu_base + (s->cur_addr - e->xspi_base),
+                                      s->word, s->word_size, false);
+        }
+        break;
+    }
+    default:
+        st = ERB_ST_DECERR;
+    }
+    erbium_set_axi_error(s, st);
+    s->word_valid = true;
+    s->word_pos = 0;
+}
+
+static void erbium_word_commit(ErbiumXSPI *s)
+{
+    int st = ERB_ST_OK;
+
+    if (s->word_pos == 0) {
+        return;
+    }
+    if (s->word_pos != s->word_size) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "erbium-xspi: partial %u-byte word (%u bytes) at 0x%" PRIx64
+                      " (data must be a multiple of %u bytes)\n",
+                      s->word_size, s->word_pos, s->cur_addr, s->word_size);
+        if (s->strict) {
+            erbium_set_axi_error(s, ERB_ST_SLVERR);
+            s->word_pos = 0;
+            return;
+        }
+    }
+    switch (s->target) {
+    case ERB_TGT_MRAM:
+        if (s->cur_addr + s->word_pos <= ERBIUM_MRAM_SIZE) {
+            memcpy(s->mram + s->cur_addr, s->word, s->word_pos);
+        } else {
+            st = ERB_ST_DECERR;
+        }
+        break;
+    case ERB_TGT_SCCR:
+        erbium_xspi_sccr_write(s, s->cur_addr, ldl_le_p(s->word));
+        break;
+    case ERB_TGT_REMOTE: {
+        const ErbiumMapEntry *e = erbium_map_lookup(s->cur_addr);
+        if (!e) {
+            st = ERB_ST_DECERR;
+        } else {
+            st = erbium_remote_access(s, e->cpu_base + (s->cur_addr - e->xspi_base),
+                                      s->word, s->word_pos, true);
+        }
+        break;
+    }
+    default:
+        st = ERB_ST_SLVERR;   /* write to SFDP etc. */
+    }
+    erbium_set_axi_error(s, st);
+    s->word_pos = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Command decode                                                      */
+
+static void erbium_begin_command(ErbiumXSPI *s)
+{
+    bool spi = erbium_is_spi_mode(s);
+
+    s->target = ERB_TGT_NONE;
+    s->is_write = false;
+    s->addr_bytes = 0;
+    s->latency_bytes = 0;
+    s->word_size = 8;
+
+    switch (s->opcode) {
+    case ERB_OP_NOP:
+        s->phase = ERB_PHASE_DONE;
+        return;
+    case ERB_OP_RESET:
+        s->reset_pending = true;
+        s->phase = ERB_PHASE_DONE;
+        return;
+    case ERB_OP_SET_RATE:
+        s->is_write = true;
+        s->word_size = 3;
+        break;
+    case ERB_OP_READ_SFDP:
+        s->target = ERB_TGT_SFDP;
+        s->addr_bytes = spi ? 3 : 4;
+        s->latency_bytes = erbium_latency_bytes(s);
+        s->word_size = 1;
+        break;
+    case ERB_OP_READ_REG:
+        s->target = ERB_TGT_SCCR;
+        s->addr_bytes = spi ? 3 : 4;
+        s->latency_bytes = erbium_latency_bytes(s);
+        s->word_size = 4;
+        break;
+    case ERB_OP_WRITE_REG:
+        s->target = ERB_TGT_SCCR;
+        s->addr_bytes = spi ? 3 : 4;
+        s->is_write = true;
+        s->word_size = 4;
+        break;
+    case ERB_OP_READ_MEM:
+        s->target = ERB_TGT_REMOTE;  /* resolved after address */
+        s->addr_bytes = 4;
+        s->latency_bytes = erbium_latency_bytes(s);
+        break;
+    case ERB_OP_WRITE_MEM:
+        s->target = ERB_TGT_REMOTE;
+        s->addr_bytes = 4;
+        s->is_write = true;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "erbium-xspi: unknown opcode 0x%02x\n",
+                      s->opcode);
+        trace_erbium_xspi_invalid(s->opcode, s->cmd_rate);
+        s->cmd_error = true;
+        s->phase = ERB_PHASE_DONE;
+        return;
+    }
+
+    s->after_ext = s->addr_bytes ? ERB_PHASE_ADDR : ERB_PHASE_DATA;
+    s->phase = spi ? s->after_ext : ERB_PHASE_EXT;
+    s->addr = 0;
+    s->addr_got = 0;
+    s->latency_got = 0;
+    s->word_pos = 0;
+    s->word_valid = false;
+}
+
+static void erbium_address_done(ErbiumXSPI *s)
+{
+    s->cur_addr = s->addr;
+    s->bytes_done = 0;
+
+    if (s->target == ERB_TGT_REMOTE) {
+        const ErbiumMapEntry *e = erbium_map_lookup(s->addr);
+        if (e) {
+            s->target = e->target;
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "erbium-xspi: memory op 0x%02x to unmapped 0x%08x\n",
+                          s->opcode, s->addr);
+        }
+    }
+    trace_erbium_xspi_command(s->opcode, s->cmd_rate, s->addr_rate,
+                              s->data_rate, s->addr, s->latency_bytes,
+                              s->is_write);
+    s->phase = (s->is_write || !s->latency_bytes) ? ERB_PHASE_DATA
+                                                  : ERB_PHASE_LATENCY;
+}
+
+static uint8_t erbium_data_byte(ErbiumXSPI *s, uint8_t tx)
+{
+    uint8_t rx = 0xff;
+
+    if (s->is_write) {
+        s->word[s->word_pos++] = tx;
+        s->bytes_done++;
+        if (s->word_pos == s->word_size) {
+            if (s->opcode == ERB_OP_SET_RATE) {
+                memcpy(s->pending_rate, s->word, 3);
+                s->rate_pending = true;
+                s->phase = ERB_PHASE_DONE;
+                s->word_pos = 0;
+            } else {
+                erbium_word_commit(s);
+                s->cur_addr += s->word_size;
+            }
+        }
+    } else {
+        if (!s->word_valid) {
+            erbium_word_fetch(s);
+        }
+        rx = s->word[s->word_pos++];
+        s->bytes_done++;
+        if (s->word_pos == s->word_size) {
+            s->word_valid = false;
+            s->cur_addr += s->word_size;
+        }
+    }
+    return rx;
+}
+
+static uint32_t erbium_xspi_transfer(SSIPeripheral *ss, uint32_t tx)
+{
+    ErbiumXSPI *s = ERBIUM_XSPI(ss);
+    uint8_t b = tx & 0xff;
+
+    switch (s->phase) {
+    case ERB_PHASE_CMD:
+        s->opcode = b;
+        s->cmd_error = false;
+        erbium_begin_command(s);
+        return 0;
+
+    case ERB_PHASE_EXT:
+        s->ext = b;
+        if (s->ext_check && b != (uint8_t)~s->opcode) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "erbium-xspi: bad opcode extension 0x%02x for 0x%02x\n",
+                          b, s->opcode);
+            trace_erbium_xspi_invalid(s->opcode, s->cmd_rate);
+        }
+        s->phase = s->after_ext;
+        return 0;
+
+    case ERB_PHASE_ADDR:
+        s->addr = (s->addr << 8) | b;
+        if (++s->addr_got == s->addr_bytes) {
+            erbium_address_done(s);
+        }
+        return 0;
+
+    case ERB_PHASE_LATENCY:
+        if (++s->latency_got >= s->latency_bytes) {
+            s->phase = ERB_PHASE_DATA;
+        }
+        return 0;
+
+    case ERB_PHASE_DATA:
+        return erbium_data_byte(s, b);
+
+    case ERB_PHASE_DONE:
+    default:
+        return 0;
+    }
+}
+
+static void erbium_xspi_soft_reset(ErbiumXSPI *s)
+{
+    trace_erbium_xspi_reset("command");
+    memcpy(s->sccr, erbium_sccr_reset, sizeof(s->sccr));
+    s->rate_pending = false;
+    /* 0x99: "Reset Device and Enter default mode (1S)" */
+    erbium_apply_rates(s, ERB_RATE_S1, ERB_RATE_S1, ERB_RATE_S1);
+    if (s->backend_connected) {
+        erbium_backend_xfer(s, ERB_MSGOP_RESET, 1, NULL, 0, false);
+    }
+}
+
+static int erbium_xspi_set_cs(SSIPeripheral *ss, bool level)
+{
+    ErbiumXSPI *s = ERBIUM_XSPI(ss);
+
+    if (level) {
+        /* CS deasserted: finalize */
+        if (s->phase == ERB_PHASE_DATA && s->is_write) {
+            erbium_word_commit(s);
+        }
+        if (s->phase == ERB_PHASE_DATA || s->phase == ERB_PHASE_LATENCY ||
+            s->phase == ERB_PHASE_DONE) {
+            trace_erbium_xspi_cs_done(s->opcode, s->addr, s->bytes_done);
+        } else if (s->phase != ERB_PHASE_CMD) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "erbium-xspi: CS released mid-command (op 0x%02x, phase %d)\n",
+                          s->opcode, s->phase);
+        }
+        if (s->rate_pending) {
+            s->rate_pending = false;
+            if (erbium_rate_valid(s->pending_rate[0]) &&
+                erbium_rate_valid(s->pending_rate[1]) &&
+                erbium_rate_valid(s->pending_rate[2])) {
+                erbium_apply_rates(s, s->pending_rate[0], s->pending_rate[1],
+                                   s->pending_rate[2]);
+            } else {
+                qemu_log_mask(LOG_GUEST_ERROR,
+                              "erbium-xspi: invalid setRate %02x %02x %02x\n",
+                              s->pending_rate[0], s->pending_rate[1],
+                              s->pending_rate[2]);
+            }
+        }
+        if (s->reset_pending) {
+            s->reset_pending = false;
+            erbium_xspi_soft_reset(s);
+        }
+    }
+    s->phase = ERB_PHASE_CMD;
+    s->word_pos = 0;
+    s->word_valid = false;
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* QOM                                                                 */
+
+static void erbium_xspi_reset(DeviceState *dev)
+{
+    ErbiumXSPI *s = ERBIUM_XSPI(dev);
+
+    trace_erbium_xspi_reset("device");
+    memcpy(s->sccr, erbium_sccr_reset, sizeof(s->sccr));
+    s->phase = ERB_PHASE_CMD;
+    s->rate_pending = false;
+    s->reset_pending = false;
+    s->word_pos = 0;
+    s->word_valid = false;
+    erbium_apply_default_mode(s);
+    if (s->stub_sysregs) {
+        memset(s->stub_sysregs, 0, ERB_STUB_SYSREGS_SIZE);
+    }
+    if (s->backend_connected) {
+        erbium_backend_xfer(s, ERB_MSGOP_RESET, 0, NULL, 0, false);
+    }
+}
+
+static void erbium_xspi_realize(SSIPeripheral *ss, Error **errp)
+{
+    ErbiumXSPI *s = ERBIUM_XSPI(ss);
+
+    if (s->memdev) {
+        MemoryRegion *mr = host_memory_backend_get_memory(s->memdev);
+        if (memory_region_size(mr) < ERBIUM_MRAM_SIZE) {
+            error_setg(errp, "erbium-xspi: memdev must be at least 16 MiB");
+            return;
+        }
+        host_memory_backend_set_mapped(s->memdev, true);
+        s->mram = memory_region_get_ram_ptr(mr);
+    } else {
+        s->mram_local = g_malloc0(ERBIUM_MRAM_SIZE);
+        s->mram = s->mram_local;
+    }
+    s->stub_sysregs = g_malloc0(ERB_STUB_SYSREGS_SIZE);
+    s->stub_sram = g_malloc0(ERB_STUB_SRAM_SIZE);
+
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        uint8_t info[64];
+        s->backend_connected = true;
+        if (erbium_backend_xfer(s, ERB_MSGOP_PING, 0, info, sizeof(info),
+                                false) != ERB_ST_OK) {
+            warn_report("erbium-xspi: backend did not answer PING; using stub");
+            s->backend_connected = false;
+        }
+    }
+}
+
+static void erbium_xspi_finalize(Object *obj)
+{
+    ErbiumXSPI *s = ERBIUM_XSPI(obj);
+
+    g_free(s->mram_local);
+    g_free(s->stub_sysregs);
+    g_free(s->stub_sram);
+}
+
+static const Property erbium_xspi_properties[] = {
+    DEFINE_PROP_LINK("memdev", ErbiumXSPI, memdev, TYPE_MEMORY_BACKEND,
+                     HostMemoryBackend *),
+    DEFINE_PROP_CHR("chardev", ErbiumXSPI, chr),
+    DEFINE_PROP_UINT8("default-mode", ErbiumXSPI, default_mode, 3),
+    DEFINE_PROP_INT32("latency-bytes", ErbiumXSPI, latency_bytes_override, -1),
+    DEFINE_PROP_BOOL("strict", ErbiumXSPI, strict, false),
+    DEFINE_PROP_BOOL("ext-check", ErbiumXSPI, ext_check, false),
+};
+
+static void erbium_xspi_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = erbium_xspi_realize;
+    k->transfer = erbium_xspi_transfer;
+    k->set_cs = erbium_xspi_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_props(dc, erbium_xspi_properties);
+    device_class_set_legacy_reset(dc, erbium_xspi_reset);
+    set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
+    dc->desc = "Erbium xSPI target (16 MiB MRAM + control plane)";
+    /* Migration of the shared-memory/backend state is not supported. */
+    dc->vmsd = NULL;
+}
+
+static const TypeInfo erbium_xspi_info = {
+    .name              = TYPE_ERBIUM_XSPI,
+    .parent            = TYPE_SSI_PERIPHERAL,
+    .instance_size     = sizeof(ErbiumXSPI),
+    .instance_finalize = erbium_xspi_finalize,
+    .class_init        = erbium_xspi_class_init,
+};
+
+static void erbium_xspi_register_types(void)
+{
+    type_register_static(&erbium_xspi_info);
+}
+
+type_init(erbium_xspi_register_types)
