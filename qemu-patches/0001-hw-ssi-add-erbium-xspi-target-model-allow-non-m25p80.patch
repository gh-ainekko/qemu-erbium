From 0ed6dbd215004d3674057890382b1728b788bb4b Mon Sep 17 00:00:00 2001
From: "exe.dev user" <exedev@erbium-qemu.exe.xyz>
Date: Tue, 29 Sep 2026 23:05:38 +0000
Subject: [PATCH 1/7] hw/ssi: add erbium-xspi target model; allow non-m25p80
 ospi-model on xlnx-versal-virt

Co-authored-by: Shelley <shelley@exe.dev>
---
 hw/arm/xlnx-versal-virt.c    |  17 +-
 hw/ssi/Kconfig               |   6 +
 hw/ssi/erbium-xspi-sfdp.c    | 190 +++++++++
 hw/ssi/erbium-xspi.c         | 744 +++++++++++++++++++++++++++++++++++
 hw/ssi/meson.build           |   1 +
 hw/ssi/trace-events          |  11 +
 include/hw/ssi/erbium-xspi.h | 149 +++++++
 7 files changed, 1115 insertions(+), 3 deletions(-)
 create mode 100644 hw/ssi/erbium-xspi-sfdp.c
 create mode 100644 hw/ssi/erbium-xspi.c
 create mode 100644 include/hw/ssi/erbium-xspi.h

diff --git a/hw/arm/xlnx-versal-virt.c b/hw/arm/xlnx-versal-virt.c
index 5e05521..9037818 100644
--- a/hw/arm/xlnx-versal-virt.c
+++ b/hw/arm/xlnx-versal-virt.c
@@ -16,6 +16,7 @@
 #include "system/device_tree.h"
 #include "system/address-spaces.h"
 #include "hw/block/flash.h"
+#include "hw/ssi/ssi.h"
 #include "hw/boards.h"
 #include "hw/sysbus.h"
 #include "hw/arm/fdt.h"
@@ -295,23 +296,33 @@ static void versal_virt_init(MachineState *machine)
         DriveInfo *dinfo = drive_get(IF_MTD, 0, i);
         BlockBackend *blk;
         const char *mdl;
+        bool is_m25p80 = true;
 
         if (s->cfg.ospi_model) {
             flash_klass = object_class_by_name(s->cfg.ospi_model);
             if (!flash_klass ||
                 object_class_is_abstract(flash_klass) ||
-                !object_class_dynamic_cast(flash_klass, TYPE_M25P80)) {
+                !object_class_dynamic_cast(flash_klass, TYPE_SSI_PERIPHERAL)) {
                 error_report("'%s' is either abstract or"
-                       " not a subtype of m25p80", s->cfg.ospi_model);
+                       " not an SSI peripheral", s->cfg.ospi_model);
                 exit(1);
             }
+            is_m25p80 = !!object_class_dynamic_cast(flash_klass, TYPE_M25P80);
             mdl = s->cfg.ospi_model;
         } else {
             mdl = "mt35xu01g";
         }
 
+        /*
+         * Non-flash SSI peripherals (e.g. erbium-xspi) are single devices
+         * configured through -global; only populate chip-select 0.
+         */
+        if (!is_m25p80 && i > 0) {
+            continue;
+        }
+
         blk = dinfo ? blk_by_legacy_dinfo(dinfo) : NULL;
-        versal_ospi_create_flash(&s->soc, i, mdl, blk);
+        versal_ospi_create_flash(&s->soc, i, mdl, is_m25p80 ? blk : NULL);
     }
 }
 
diff --git a/hw/ssi/Kconfig b/hw/ssi/Kconfig
index 1355e4b..830faef 100644
--- a/hw/ssi/Kconfig
+++ b/hw/ssi/Kconfig
@@ -36,3 +36,9 @@ config PNV_SPI
 config ALLWINNER_A10_SPI
     bool
     select SSI
+
+config ERBIUM_XSPI
+    bool
+    default y
+    depends on SSI
+    select SSI
