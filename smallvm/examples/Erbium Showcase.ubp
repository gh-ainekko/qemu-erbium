module main
author 'Erbium'
version 1 0
description 'No GPIO required: functions, lists, variables, and a counter paced by 100 milliseconds of simulated board time (not wall time). Press start, inspect counter/status/answer/history, then stop.'
variables counter status answer history elapsed

spec 'r' 'doublePlusOne' 'double _ plus one' 'num' 20

to doublePlusOne n {
  return ((n * 2) + 1)
}

script 40 40 {
whenStarted
counter = 0
status = 'running'
answer = (doublePlusOne 20)
history = (newList 3 10)
atPut 2 history 20
atPut 3 history 30
resetTimer
forever {
  waitMillis 100
  counter += 1
  elapsed = (timer)
  atPut 1 history counter
}
}

script 430 40 {
comment 'The answer should be 41. Counter increments every 100 ms. No physical peripherals are used.'
}
