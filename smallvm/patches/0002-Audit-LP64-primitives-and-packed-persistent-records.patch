+// Validate both header words and the full payload before pointer arithmetic.
+static int recordSpan(int *p, int *start, int *end) {
+	uintptr_t addr = (uintptr_t)p;
+	if (addr < (uintptr_t)start || addr >= (uintptr_t)end || (addr & 3)) return 0;
+	if ((end - p) < 2 || ((uint32_t)*p >> 24) != 'R') return 0;
+	int words = p[1];
+	if (words < 0 || words > (end - p) - 2) return 0;
+	int span = words + 2;
+	#if defined(DUELink)
+		if (words & 1) span++;
+	#endif
+	return (span <= (end - p)) ? span : 0;
+}
