 // Integer Evaluation
 
+// strtol's range follows native long, which changes on LP64. Match the old
+// 32-bit decimal conversion, and never read past a byte array's logical end.
+static inline int parseInt32(const char *s, int byteCount) {
+	while (byteCount > 0 && (*s == ' ' || (*s >= '\t' && *s <= '\r'))) {
+		s++; byteCount--;
+	}
+	int negative = 0;
+	if (byteCount > 0 && (*s == '-' || *s == '+')) {
+		negative = (*s == '-'); s++; byteCount--;
+	}
+	uint32_t result = 0;
+	uint32_t limit = negative ? UINT32_C(0x80000000) : UINT32_C(0x7FFFFFFF);
+	while (byteCount > 0 && *s >= '0' && *s <= '9') {
+		unsigned digit = *s++ - '0';
+		byteCount--;
+		if (result > (limit - digit) / 10) { result = limit; break; }
+		result = 10 * result + digit;
+	}
+	if (negative && result == UINT32_C(0x80000000)) return (-2147483647 - 1);
+	return negative ? -(int)result : (int)result;
+}
