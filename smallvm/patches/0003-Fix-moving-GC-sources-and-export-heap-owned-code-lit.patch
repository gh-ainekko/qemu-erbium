+static OBJ parseBasedInteger(const char *s, unsigned base) {
+	// Do not rely on strtol saturation or native long width. Positive patterns
+	// use up to 31 bits; negative magnitudes must fit the signed VM range.
+	while (*s == ' ' || (*s >= '\t' && *s <= '\r')) s++;
+	int negative = 0;
+	if (*s == '-' || *s == '+') { negative = (*s == '-'); s++; }
+	if (base == 16 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) s += 2;
+	uint32_t result = 0;
+	uint32_t limit = negative ? UINT32_C(0x40000000) : UINT32_C(0x7FFFFFFF);
+	while (*s) {
+		unsigned digit;
+		if (*s >= '0' && *s <= '9') digit = *s - '0';
+		else if (*s >= 'a' && *s <= 'f') digit = *s - 'a' + 10;
+		else if (*s >= 'A' && *s <= 'F') digit = *s - 'A' + 10;
+		else break;
+		if (digit >= base) break;
+		if (result > (limit - digit) / base) return fail(hexRangeError);
+		result = result * base + digit;
+		s++;
+	}
+	return int2obj(negative ? (uint32_t)0 - result : result);
+}
+
 OBJ primHexToInt(int argCount, OBJ *args) {
 	if (!IS_TYPE(args[0], StringType)) return fail(needsStringError);
 
 	char *s = obj2str(args[0]);
 	if ('#' == *s) s++; // skip leading # if there is one
-	if (('0' == *s) && (('x' == s[1]) || ('X' == s[1]))) s += 2; // skip leading '0x' or '0X'
-	long result = strtol(s, NULL, 16);
-	// Interpret the low 31 bits as a signed VM integer, independent of C long.
-	// Positive bit patterns with bit 30 set represent negative VM integers.
-	if ((result < -0x40000000L) || (result > 0x7FFFFFFFL)) return fail(hexRangeError);
-	return int2obj((uint32_t) result);
+	return parseBasedInteger(s, 16);
 }
 
 OBJ primBinaryToInt(int argCount, OBJ *args) {
 	if (!IS_TYPE(args[0], StringType)) return fail(needsStringError);
 
-	char *s = obj2str(args[0]);
-	long result = strtol(s, NULL, 2);
-	if ((result < -0x40000000L) || (result > 0x7FFFFFFFL)) return fail(hexRangeError);
-	return int2obj((uint32_t) result);
+	return parseBasedInteger(obj2str(args[0]), 2);
 }
 
