 		byteCount = obj2int(FIELD(arg, 0));
diff --git a/vm/interp.c b/vm/interp.c
index cba6ec0..3b9b213 100644
--- a/vm/interp.c
+++ b/vm/interp.c
@@ -652,7 +652,21 @@ static void runTask(Task *task) {
 	pushLiteral_op:
 		STACK_CHECK(1);
 		tmp = *ip; // offset to the literal is in the following 16-bit word
-		*sp++ = ptrToObj(ip++ + tmp);
+		tmpObj = ptrToObj(ip++ + tmp);
+		// Export heap-owned binary literals, not references into the moving code
+		// store. Preserve the packed header (including byte-array size adjustment).
+		// Primitive-name operands below remain lookup-only code references.
+		{
+			int type = TYPE(tmpObj);
+			int words = WORDS(tmpObj);
+			if (type != StringType && type != ByteArrayType) {
+				fail(needsStringError);
+				goto error;
+			}
+			OBJ literal = newObj(type, words, falseObj);
+			if (literal) memcpy(objToPtr(literal), objToPtr(tmpObj), 4 * (words + 1));
+			*sp++ = literal;
+		}
 		DISPATCH();
 	pushGlobal_op:
 		STACK_CHECK(1);
diff --git a/vm/mem.c b/vm/mem.c
index 19f0887..13db53b 100644
--- a/vm/mem.c
+++ b/vm/mem.c
@@ -459,6 +459,9 @@ void mark(OBJ root) {
 
 	OBJ current = root;
 	int i = (TYPE(current) > BinaryObjectTypes) ? WORDS(current) : 0; // scan backwards from last field
+	// The forwarding field is also the "visiting" marker. Mark before scanning,
+	// including when no prior descent has recorded a parent field index.
+	SET_MARK(current);
 
 	while (1) {
 		if (i == 0) { // done processing fields of the current object
@@ -484,6 +487,7 @@ void mark(OBJ root) {
 				i = WORDS(child); // scan backwards from last field of child
 				*objToPtr(child) = objBits(current); // backpointer to current
 				current = child; // process child
+				SET_MARK(current); // self/ancestor edges must not reverse this header again
 			} else {
 				SET_MARK(child);
 			}
