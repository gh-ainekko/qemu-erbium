#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t debugfs none /sys/kernel/debug 2>/dev/null
mount -t devtmpfs none /dev
# A failed requested mount must not leave a misleading writable empty /mnt/host.
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        erbium.share=ro|erbium.share=rw)
            mode=${arg#erbium.share=}
            if ! mount -t 9p -o "trans=virtio,version=9p2000.L,cache=none,nodev,nosuid,$mode" hostshare /mnt/host; then
                echo "ERBIUM-SHARE-MOUNT-FAILED: hostshare ($mode)" >&2
                poweroff -f
                while :; do sleep 3600; done
            fi
            echo "Host share mounted at /mnt/host ($mode)"
            ;;
    esac
done
echo "erbium guest up"
if grep -q erbium.sharetest /proc/cmdline; then
    sh /etc/erbium-share-test.sh
    RC=$?
    echo "ERBIUM-SHARE-TEST-RESULT $RC"
    poweroff -f
elif grep -q erbium.kotamatest /proc/cmdline; then
    sh /etc/erbium-uart-test.sh --kotama
    RC=$?
    echo "ERBIUM-KOTAMA-UART-TEST-RESULT $RC"
    if grep -q erbium.poweroff /proc/cmdline; then poweroff -f; fi
elif grep -q erbium.uarttest /proc/cmdline; then
    sh /etc/erbium-uart-test.sh
    RC=$?
    echo "ERBIUM-UART-TEST-RESULT $RC"
    if grep -q erbium.poweroff /proc/cmdline; then poweroff -f; fi
elif grep -q erbium.loadtest /proc/cmdline; then
    sh /etc/erbium-load-test.sh
    RC=$?
    echo "ERBIUM-LOAD-TEST-RESULT $RC"
    if grep -q erbium.poweroff /proc/cmdline; then
        poweroff -f
    fi
elif [ -f /etc/erbium-test.sh ] && grep -q erbium.autotest /proc/cmdline; then
    sh /etc/erbium-test.sh
    RC=$?
    echo "ERBIUM-TEST-RESULT $RC"
    if grep -q erbium.poweroff /proc/cmdline; then
        poweroff -f
    fi
fi
exec setsid cttyhack sh
