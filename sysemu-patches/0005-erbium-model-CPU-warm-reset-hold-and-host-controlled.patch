diff --git a/sw-sysemu/tests/erbium/host/test_cpu_reset.py b/sw-sysemu/tests/erbium/host/test_cpu_reset.py
new file mode 100644
index 0000000..c4cd5a3
--- /dev/null
+++ b/sw-sysemu/tests/erbium/host/test_cpu_reset.py
@@ -0,0 +1,403 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 Ainekko, Co.
+# SPDX-License-Identifier: Apache-2.0
+"""Standalone reset/start regressions; only Python's standard library is needed.
+
+python3 test_cpu_reset.py --emu /path/to/built/erbium_emu
+
+No ELF, cross compiler, QEMU, UART, or pytest required. Small RV64 instruction
+streams are uploaded through the existing backend socket client, never through
+the MRAM backing file. The file is used only to exercise the shared-MRAM profile.
+"""
+
+import argparse
+import contextlib
+from pathlib import Path
+
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "tools"))
+from erb_client import ErbClient  # noqa: E402
+
+SOFT_RESET = 0x02000028
+MAILBOX0 = 0x02000068
+MAILBOX1 = 0x02000070
+MINION_BOOT = 0x80D00018
+IPI_REDIRECT_PC = 0x80100040
+THREAD0_DISABLE = 0x80F40240
+THREAD1_DISABLE = 0x80F40010
+MTIME = 0x80F40200
+SRAM = 0x0200C000
+BOOTROM = 0x02008000
+PC_A = 0x40001000
+PC_B = 0x40002000
+DATA_A = 0x40010000
+DATA_B = 0x40011000
+SENTINEL = 0x40030000
+DEADLINE = 5
+
+
+def check(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def read(client, addr, size):
+    status, data = client.read(addr, size)
+    check(status == 0, f"read 0x{addr:x}: status {status}")
+    check(len(data) == size, f"short read at 0x{addr:x}")
+    return data
+
+
+def write(client, addr, data):
+    check(client.write(addr, data) == 0, f"write 0x{addr:x} failed")
+
+
+def u32(client, addr):
+    return struct.unpack("<I", read(client, addr, 4))[0]
+
+
+def u64(client, addr):
+    return struct.unpack("<Q", read(client, addr, 8))[0]
+
+
+def w32(client, addr, value):
+    write(client, addr, struct.pack("<I", value))
+
+
+def w64(client, addr, value):
+    write(client, addr, struct.pack("<Q", value))
+
+
+def ping(client):
+    status, info = client.ping()
+    check(status == 0 and info["name"] == "erbium_emu", "PING failed")
+
+
+def until(predicate, description):
+    deadline = time.monotonic() + DEADLINE
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(0.005)
+    raise AssertionError(f"timeout: {description}")
+
+
+def masks(client, t0, t1):
+    w64(client, THREAD0_DISABLE, t0)
+    w64(client, THREAD1_DISABLE, t1)
+
+
+def counts(client, base):
+    return struct.unpack("<4Q", read(client, base, 32))
+
+
+def stable(client, base, description):
+    before = read(client, base, 32)
+    # Multiple round trips also force service beyond the reset-write cycle.
+    for _ in range(5):
+        ping(client)
+        time.sleep(0.01)
+        check(read(client, base, 32) == before, description)
+
+
+def incrementing(client, base, selected=(0,)):
+    before = counts(client, base)
+    until(lambda: all(counts(client, base)[h] > before[h] for h in selected),
+          f"harts {selected} executing at data 0x{base:x}")
+
+
+def sd(rs, offset, base=5):
+    return ((offset >> 5) << 25) | (rs << 20) | (base << 15) | (3 << 12) | ((offset & 31) << 7) | 0x23
+
+
+def counter_code(base, step=1, sleep=False):
+    # t0 = data + 8*mhartid. Record the reset MIE before deliberately dirtying
+    # it, then increment a separate counter for each hart. No shared atomics.
+    insns = [
+        (base & 0xFFFFF000) | (5 << 7) | 0x37,          # lui t0, data>>12
+        (0xF14 << 20) | (2 << 12) | (6 << 7) | 0x73,  # csrr t1, mhartid
+        (3 << 20) | (6 << 15) | (1 << 12) | (6 << 7) | 0x13,
+        (6 << 20) | (5 << 15) | (5 << 7) | 0x33,       # add t0,t0,t1
+        (0x304 << 20) | (2 << 12) | (28 << 7) | 0x73, # csrr t3,mie
+        sd(28, 128),                                 # sd t3,128(t0)
+        (0x304 << 20) | (8 << 15) | (5 << 12) | 0x73, # csrrwi zero,mie,8
+        (5 << 15) | (3 << 12) | (7 << 7) | 0x03,      # ld t2,0(t0)
+        (step << 20) | (7 << 15) | (7 << 7) | 0x13,   # addi t2,t2,step
+        sd(7, 0),
+    ]
+    if sleep:
+        insns += [0x10500073, 0xFFDFF06F]             # wfi; j -4
+    else:
+        insns += [0xFF5FF06F]                        # j -12 (ld/addi/sd)
+    return struct.pack("<" + "I" * len(insns), *insns)
+
+
+def self_hold_code():
+    # CPU-originated MMIO must not unlink the active-list iterator mid-loop.
+    # The final store is forbidden while held and proves execution stopped.
+    return struct.pack("<6I",
+                       0x020002B7,                   # lui t0,0x02000
+                       0x00600313,                   # li t1,6
+                       0x0262A423,                   # sw t1,0x28(t0)
+                       0x400103B7,                   # lui t2,0x40010
+                       sd(6, 0, 7),                  # sd t1,0(t2)
+                       0x0000006F)                   # j .
+
+
+@contextlib.contextmanager
+def backend(emu, held, extra=()):
+    with tempfile.TemporaryDirectory(prefix="erbium-reset-") as tmp:
+        sock = str(Path(tmp) / "api.sock")
+        log_path = Path(tmp) / "emu.log"
+        args = [str(emu), "-minions", "0x3", "-reset_pc", hex(PC_A),
+                "--api-socket", sock, "--mram-file", str(Path(tmp) / "mram.img")]
+        if held:
+            args.append("--start-held")
+        args += list(extra)
+        with log_path.open("wb") as log:
+            proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=log)
+            client = None
+            try:
+                deadline = time.monotonic() + DEADLINE
+                while time.monotonic() < deadline:
+                    check(proc.poll() is None, "backend exited before socket connection")
+                    try:
+                        client = ErbClient(sock)
+                        client.sock.settimeout(DEADLINE)
+                        break
+                    except (FileNotFoundError, ConnectionRefusedError):
+                        time.sleep(0.01)
+                check(client is not None, "backend never accepted a connection")
+                yield client, sock
+                check(proc.poll() is None, "backend exited during test")
+            except BaseException:
+                log.flush()
+                print(log_path.read_text(errors="replace")[-12000:], file=sys.stderr)
+                raise
+            finally:
+                if client:
+                    client.close()
+                proc.terminate()
+                try:
+                    proc.wait(timeout=DEADLINE)
+                except subprocess.TimeoutExpired:
+                    proc.kill()
+                    proc.wait()
+                log.flush()
+                text = log_path.read_text(errors="replace")
+                check("FATAL" not in text and "fatal error in chip model" not in text,
+                      "backend encountered a fatal CPU/model error:\n" + text[-8000:])
+
+
+def test_held(emu):
+    with backend(emu, True) as (client, sock):
+        ping(client)
+        check(u32(client, SOFT_RESET) == 6, "startup must expose warm hold + MRAM rst_b")
+        # Bit 2 is active-low and independent: changing it must not release
+        # the warm hold or be mistaken for a CPU/whole-system reset.
+        w32(client, SOFT_RESET, 2)
+        check(u32(client, SOFT_RESET) == 2, "MRAM rst_b polarity/value lost")
+        w32(client, SOFT_RESET, 6)
+        w32(client, SOFT_RESET, 0xFFFFFFF6)
+        check(u32(client, SOFT_RESET) == 6, "reserved SoftReset bits not masked")
+        check(u64(client, MINION_BOOT) == PC_A, "CLI boot PC not initialized")
+        write(client, PC_A, counter_code(DATA_A))
+        write(client, PC_B, counter_code(DATA_B))
+        write(client, DATA_A, bytes(256))
+        write(client, DATA_B, bytes(256))
+        # Enable both threads on both instantiated minions while held.
+        for _ in range(3):
+            masks(client, 0xFF, 0xFF)
+            masks(client, 0xFC, 0xFC)
+        stable(client, DATA_A, "mask changes executed old PC under startup hold")
+        stable(client, DATA_B, "mask changes executed new PC under startup hold")
+        # The peripheral clock and API must continue while CPUs cannot execute.
+        before = u64(client, MTIME)
+        until(lambda: u64(client, MTIME) > before, "timer progress while held")
+        write(client, SENTINEL, b"persistent MRAM!")
+        write(client, SRAM, b"persistent SRAM!")
+        w32(client, MAILBOX0, 0x12345678)
+        w32(client, MAILBOX1, 0x87654321)
+        w64(client, MINION_BOOT, PC_B)
+        w64(client, IPI_REDIRECT_PC, PC_B)
+        masks(client, 0xFE, 0xFF)
+        w32(client, SOFT_RESET, 4)
+        incrementing(client, DATA_B)
+        check(u64(client, IPI_REDIRECT_PC) == PC_B, "release reset an ESR programmed while held")
+        stable(client, DATA_A, "release sampled assertion/CLI PC rather than new MINION_BOOT")
+        check(counts(client, DATA_B)[1:] == (0, 0, 0), "release ignored disabled threads")
+        check(u64(client, DATA_B + 128) == 0, "MIE not reset on first release")
+
+        # A boot-register write alone must not redirect an executing hart.
+        w64(client, MINION_BOOT, PC_A)
+        incrementing(client, DATA_B)
+        stable(client, DATA_A, "MINION_BOOT redirected CPU without a reset")
+
+        # xSPI-only reset must not change CPU state, ESRs, or system registers.
+        check(client.reset(1) == 0, "xSPI-only RESET failed")
+        check(u32(client, SOFT_RESET) == 4, "xSPI-only RESET changed SoftReset")
+        check(u64(client, MINION_BOOT) == PC_A, "xSPI-only RESET changed boot PC")
+        check(u64(client, THREAD0_DISABLE) == 0xFE, "xSPI-only RESET changed masks")
+        check(u32(client, MAILBOX1) == 0x87654321, "xSPI-only RESET cleared peripheral")
+        incrementing(client, DATA_B)
+
+        # Repeat upload/start at the SAME PC: changed code must not use a stale
+        # fetch buffer, dirty MIE must reset, and memory/peripherals must survive.
+        for step in (7, 11, 3):
+            w32(client, SOFT_RESET, 6)
+            stable(client, DATA_B, "CPU continued executing under warm hold")
+            check(read(client, SENTINEL, 16) == b"persistent MRAM!", "warm reset erased MRAM")
+            check(read(client, SRAM, 16) == b"persistent SRAM!", "warm reset erased SRAM")
+            check(u32(client, MAILBOX0) == 0x12345678, "warm reset cleared Mailbox0")
+            check(u32(client, MAILBOX1) == 0x87654321, "warm reset cleared Mailbox1")
+            check(client.reset(1) == 0, "xSPI-only RESET while held failed")
+            check(u32(client, SOFT_RESET) == 6, "xSPI-only RESET released hold")
+            masks(client, 0xFF, 0xFF)
+            write(client, PC_B, counter_code(DATA_B, step))
+            write(client, DATA_B, bytes(128) + b"\xff" * 32)
+            w64(client, MINION_BOOT, PC_B)
+            masks(client, 0xFC, 0xFC)
+            # Reasserting the level does not release or wipe host configuration.
+            w32(client, SOFT_RESET, 6)
+            stable(client, DATA_B, "enabled threads escaped warm hold")
+            check(u64(client, MINION_BOOT) == PC_B, "hold reapplied CLI boot PC")
+            w32(client, SOFT_RESET, 4)
+            incrementing(client, DATA_B, (0, 1, 2, 3))
+            values = counts(client, DATA_B)
+            check(all(v > 0 and v % step == 0 for v in values),
+                  f"reloaded instruction stream not executed: {values}, step={step}")
+            check(read(client, DATA_B + 128, 32) == bytes(32), "warm release retained dirty MIE")
+
+        # Warm reset and restart from a sleeping WFI hart, with live socket.
+        w32(client, SOFT_RESET, 6)
+        masks(client, 0xFE, 0xFF)
+        write(client, DATA_B, bytes(256))
+        write(client, PC_B, counter_code(DATA_B, sleep=True))
+        w32(client, SOFT_RESET, 4)
+        until(lambda: counts(client, DATA_B)[0] == 1, "WFI payload executed once")
+        stable(client, DATA_B, "WFI payload did not stay asleep")
+        ping(client)
+        client.close()
+        client = ErbClient(sock)
+        client.sock.settimeout(DEADLINE)
+        try:
+            ping(client)
+            w32(client, SOFT_RESET, 6)
+            stable(client, DATA_B, "sleeping CPU escaped hold")
+            write(client, PC_B, counter_code(DATA_B))
+            w32(client, SOFT_RESET, 4)
+            incrementing(client, DATA_B)
+
+            # A CPU cold pulse is NOT whole-system POR. Cold ESR defaults, no
+            # CLI boot-PC reapplication; still held if bit 1 was requested.
+            w32(client, SOFT_RESET, 0xE)
+            until(lambda: u64(client, MINION_BOOT) != PC_B, "CPU cold pulse serviced")
+            check(u32(client, SOFT_RESET) == 6, "CPU cold pulse not self-clearing/hold lost")
+            check(u64(client, MINION_BOOT) != PC_A, "CPU cold pulse reapplied CLI boot PC")
+            check(u64(client, THREAD0_DISABLE) == 0xFE, "CPU cold ESR masks not reset")
+            check(u64(client, THREAD1_DISABLE) == 0xFF, "CPU cold thread1 masks not reset")
+            check(u32(client, MAILBOX1) == 0x87654321, "CPU cold reset cleared system peripheral")
+            check(read(client, SENTINEL, 16) == b"persistent MRAM!", "CPU cold reset erased MRAM")
+            stable(client, DATA_B, "CPU cold pulse released persistent warm hold")
+
+            # Protocol kind 0 is what QEMU's RESET sends. It reapplies this
+            # explicit startup profile, even after previous releases/reloads.
+            for reset in (lambda: client.reset(0),
+                          lambda: w32(client, SOFT_RESET, 5)):
+                reset()
+                until(lambda: u64(client, MINION_BOOT) == PC_A, "whole reset serviced")
+                check(u32(client, SOFT_RESET) == 6, "POR did not restore --start-held")
+                check(u64(client, THREAD0_DISABLE) == 0xFC, "POR did not restore CLI masks")
+                check(u64(client, THREAD1_DISABLE) == 0xFC, "POR did not restore CLI thread1 masks")
+                check(u32(client, MAILBOX1) == 0, "whole reset did not reset peripheral")
+                check(read(client, SENTINEL, 16) == b"persistent MRAM!", "POR erased MRAM")
+                stable(client, DATA_A, "POR profile ran old image")
+                stable(client, DATA_B, "POR profile ran previous loaded image")
+                ping(client)
+                # Release each time so the next POR must actively reassert hold.
+                masks(client, 0xFE, 0xFF)
+                w64(client, MINION_BOOT, PC_B)
+                w32(client, SOFT_RESET, 4)
+                incrementing(client, DATA_B)
+
+            # A CPU instruction can assert persistent hold too.
+            w32(client, SOFT_RESET, 6)
+            write(client, DATA_A, bytes(256))
+            write(client, PC_A, self_hold_code())
+            w64(client, MINION_BOOT, PC_A)
+            w32(client, SOFT_RESET, 4)
+            until(lambda: u32(client, SOFT_RESET) == 6, "CPU-originated hold")
+            stable(client, DATA_A, "instruction after CPU-originated hold executed")
+            w64(client, MINION_BOOT, PC_B)
+            w32(client, SOFT_RESET, 4)
+            incrementing(client, DATA_B)
+        finally:
+            client.close()
