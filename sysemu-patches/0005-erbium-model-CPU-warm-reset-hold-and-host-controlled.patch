+def test_default(emu):
+    # Existing standalone/mailbox launches remain running by default. A raw
+    # preload keeps this regression independent of an ELF or cross compiler.
+    with tempfile.TemporaryDirectory(prefix="erbium-preload-") as tmp:
+        payload = Path(tmp) / "counter.bin"
+        payload.write_bytes(counter_code(DATA_A))
+        with backend(emu, False, ("-file_load", f"{PC_A:#x},{payload}",
+                                 "-single_thread", "-minions", "0x1")) as (client, _):
+            check(u32(client, SOFT_RESET) == 4, "default launch unexpectedly held")
+            incrementing(client, DATA_A)
+            for _ in range(2):
+                check(client.reset(0) == 0, "default POR failed")
+                check(u32(client, SOFT_RESET) == 4, "default POR unexpectedly held")
+                incrementing(client, DATA_A)
+
+
+def test_cold_pulse(emu):
+    with tempfile.TemporaryDirectory(prefix="erbium-cold-") as tmp:
+        initial = Path(tmp) / "initial.bin"
+        rom = Path(tmp) / "bootrom.bin"
+        initial.write_bytes(counter_code(DATA_A))
+        rom.write_bytes(counter_code(DATA_B))
+        extra = ("-file_load", f"{PC_A:#x},{initial}",
+                 "-file_load", f"{BOOTROM:#x},{rom}",
+                 "-single_thread", "-minions", "0x1")
+        with backend(emu, False, extra) as (client, _):
+            incrementing(client, DATA_A)
+            w32(client, MAILBOX1, 0xABCD1234)
+            write(client, SENTINEL, b"persistent MRAM!")
+            w32(client, SOFT_RESET, 0xC)
+            until(lambda: u64(client, MINION_BOOT) == BOOTROM, "unheld cold pulse serviced")
+            check(u32(client, SOFT_RESET) == 4, "unheld cold pulse retained pulse/hold")
+            incrementing(client, DATA_B)
+            stable(client, DATA_A, "cold pulse used CLI PC rather than reset ESR PC")
+            check(u32(client, MAILBOX1) == 0xABCD1234, "cold pulse reset system peripheral")
+            check(read(client, SENTINEL, 16) == b"persistent MRAM!", "cold pulse erased MRAM")
+            # Whole reset is deliberately different: initial CLI PC and profile.
+            check(client.reset(0) == 0, "POR after cold pulse failed")
+            check(u64(client, MINION_BOOT) == PC_A, "whole reset did not restore CLI PC")
+            check(u32(client, MAILBOX1) == 0, "whole reset did not clear Mailbox1")
+            incrementing(client, DATA_A)
+            stable(client, DATA_B, "POR continued CPU-cold boot-ROM stream")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--emu", required=True, type=Path, help="built erbium_emu executable")
+    args = parser.parse_args()
+    emu = args.emu.resolve()
+    check(emu.is_file(), f"emulator not found: {emu}")
+    test_held(emu)
+    print("PASS: held startup, masks, boot-PC resampling, repeat loads, warm/cold/POR, socket/WFI")
+    test_default(emu)
+    print("PASS: default running startup and repeat POR")
+    test_cold_pulse(emu)
+    print("PASS: self-clearing CPU cold pulse boots reset ESR PC, not CLI/POR profile")
+
+
+if __name__ == "__main__":
+    main()
