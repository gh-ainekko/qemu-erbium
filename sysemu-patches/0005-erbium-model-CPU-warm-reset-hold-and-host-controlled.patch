@@ -92,13 +93,79 @@ void System::begin_warm_reset(unsigned shire)
 
 void System::end_warm_reset(unsigned shire)
 {
-    // We have already reset the Minions in begin_warm_reset(), where
-    // they were set to 'unavailable', so now we just need to ensure that
-    // enabled Minion become running or halted.
+    unsigned s = shireindex(shire);
+    // MINION_BOOT can be programmed while reset is asserted. Resample it
+    // (and discard any stale fetch/interrupt state) at the release edge,
+    // without resetting the ESRs programmed by the host during the hold.
+    // Debug's per-hart reset release also calls this helper, without an
+    // intervening begin_warm_reset(). Do not reset unrelated harts there.
+    if (m_warm_reset_held[s]) {
+        for (unsigned h = 0; h < shireindex_harts(s); ++h) {
+            cpu[h + s * EMU_THREADS_PER_SHIRE].warm_reset();
+        }
+    }
+    m_warm_reset_held[s] = false;
     recalculate_thread0_enable(shire);
     recalculate_thread1_enable(shire);
 }
 
+#if EMU_ERBIUM
+void System::request_erbium_reset(bool held, bool cold, bool whole)
+{
+    m_reset_pending = true;
+    m_reset_hold = held;
+    m_reset_assertion_pending |= held;
+    m_reset_cold |= cold;
+    m_reset_whole |= whole;
+    // Gate mask writes even before the deferred reset is serviced.
+    m_warm_reset_held.fill(true);
+    for (auto& hart : cpu) {
+        if (!hart.is_nonexistent() && !hart.is_unavailable()) {
+            hart.become_unavailable();
+        }
+    }
+}
+
+
+void System::process_erbium_reset()
+{
+    if (!m_reset_pending) {
+        return;
+    }
+    const bool held = m_reset_hold;
+    const bool asserted = m_reset_assertion_pending;
+    const bool cold = m_reset_cold;
+    const bool whole = m_reset_whole;
+    m_reset_pending = m_reset_assertion_pending = m_reset_cold = m_reset_whole = false;
+
+    if (whole) {
+#ifdef SYS_EMU
+        if (m_emu) {
+            // Whole-system reset reapplies the selected startup profile.
+            m_emu->por_reset();
+            return;
+        }
+#endif
+        memory.por_reset();
+    }
+    if (cold || whole) {
+        // CPU cold pulse resets ESRs, but not memory/peripherals, and does
+        // NOT reapply CLI boot PC or thread masks.
+        cold_reset();
+    }
+    for (unsigned s = 0; s < EMU_NUM_SHIRES; ++s) {
+        // A release alone must not reset ESRs programmed during an existing
+        // hold. Retain an assertion edge if hold/release arrived in one batch.
+        if (asserted || cold || whole) {
+            begin_warm_reset(s);
+        }
+        if (!held || whole) {
+            end_warm_reset(s);
+        }
+    }
+}
+#endif
+
 void System::cold_reset_shire(unsigned shire)
 {
     unsigned s = shireindex(shire);
@@ -120,6 +187,10 @@ void System::cold_reset_shire(unsigned shire)
 
