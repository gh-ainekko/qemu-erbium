diff --git a/sw-sysemu/devices/sysregs_er.cpp b/sw-sysemu/devices/sysregs_er.cpp
index 9374788..9d7d595 100644
--- a/sw-sysemu/devices/sysregs_er.cpp
+++ b/sw-sysemu/devices/sysregs_er.cpp
@@ -154,9 +154,23 @@ void SysregsEr<Base>::write_register(const Agent& agent, uint64_t offset, uint32
             }
             break;
 
-        case SOFT_RESET:
-            soft_reset = value;
+        case SOFT_RESET: {
+            value &= SYSTEM_SOFTRESET_WRITE_MASK;
+            const uint32_t old = soft_reset;
+            // Bit 3 is a self-clearing CPU cold pulse. Bit 1 is a level
+            // hold; bit 2 is the independent active-low MRAM reset pin.
+            // MRAM reset never erases nonvolatile array contents. Controller
+            // reset timing is not modeled here.
+            const bool cold = SYSTEM_SOFTRESET_CPU_SOFT_RESET_GET(value);
+            const bool whole = SYSTEM_SOFTRESET_SOFT_RESET_GET(value);
+            const bool held = SYSTEM_SOFTRESET_CPU_WARM_RESET_GET(value);
+            soft_reset = value & ~SYSTEM_SOFTRESET_CPU_SOFT_RESET_FIELD_MASK;
+            if (cold || whole ||
+                ((old ^ value) & SYSTEM_SOFTRESET_CPU_WARM_RESET_FIELD_MASK)) {
+                agent.chip->request_erbium_reset(held, cold, whole);
+            }
             break;
+        }
 
         case POWER_DOMAIN_REQ:
             power_domain_req = value;
