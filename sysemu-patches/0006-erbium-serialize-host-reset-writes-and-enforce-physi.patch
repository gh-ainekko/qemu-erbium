-from erb_client import ErbClient  # noqa: E402
+from erb_client import (ErbClient, HDR, ERB_MAGIC, ERB_VERSION, ERB_OP_READ,
+                        ERB_OP_WRITE, ERB_OP_RESP)  # noqa: E402
 
 SOFT_RESET = 0x02000028
 MAILBOX0 = 0x02000068
 MAILBOX1 = 0x02000070
 MINION_BOOT = 0x80D00018
 IPI_REDIRECT_PC = 0x80100040
+DMCTRL = 0x80B5FF88
+HACTRL = 0x8090FF80
+HASTATUS0 = 0x8090FF88
+HASTATUS1 = 0x8090FF90
+AXDATA0 = 0x80800790
+AXDATA1 = 0x80800798
+AXPROGBUF0 = 0x808007A0
+NXPROGBUF0 = 0x808007B0
+NXPROGBUF1 = 0x808007B8
+ABSCMD = 0x808007C0
+MINION_FEATURE = 0x80F40000
 THREAD0_DISABLE = 0x80F40240
 THREAD1_DISABLE = 0x80F40010
 MTIME = 0x80F40200
@@ -74,6 +85,31 @@ def w64(client, addr, value):
     write(client, addr, struct.pack("<Q", value))
 
 
+def write_packet(addr, value, size=8):
+    data = value.to_bytes(size, "little") if isinstance(value, int) else value
+    return ERB_OP_WRITE, addr, len(data), data
+
+
+def read_packet(addr, size=8):
+    return ERB_OP_READ, addr, size, b""
+
+
+def pipeline(client, requests):
+    """Send complete requests in one raw socket write, without waiting for ACKs."""
+    client.sock.sendall(b"".join(
+        HDR.pack(ERB_MAGIC, ERB_VERSION, op, 0, size, addr) + data
+        for op, addr, size, data in requests))
+    results = []
+    for op, addr, size, _ in requests:
+        magic, version, response, status, length, raddr = HDR.unpack(client._recv_exact(HDR.size))
+        check((magic, version, response, status, raddr) ==
+              (ERB_MAGIC, ERB_VERSION, op | ERB_OP_RESP, 0, addr),
+              f"bad pipelined response to op {op}, address 0x{addr:x}")
+        check(length == (size if op == ERB_OP_READ else 0), "bad pipelined response size")
+        results.append(client._recv_exact(length))
+    return results
+
+
 def ping(client):
     status, info = client.ping()
     check(status == 0 and info["name"] == "erbium_emu", "PING failed")
@@ -385,6 +421,127 @@ def test_cold_pulse(emu):
             stable(client, DATA_B, "POR continued CPU-cold boot-ROM stream")
 
 
+def test_pipelined_resets(emu):
+    with backend(emu, True) as (client, _):
+        write(client, PC_A, counter_code(DATA_A))
+        write(client, PC_B, counter_code(DATA_B))
+        masks(client, 0xFE, 0xFF)
+        w64(client, IPI_REDIRECT_PC, PC_A)
+        w32(client, SOFT_RESET, 4)
+        incrementing(client, DATA_A)
+
+        # The first read must see assertion effects before the following
+        # programming writes. The final release must not erase those writes.
+        result = pipeline(client, [
+            write_packet(SOFT_RESET, 6, 4),
+            read_packet(IPI_REDIRECT_PC),
+            write_packet(IPI_REDIRECT_PC, PC_B),
+            write_packet(MINION_BOOT, PC_B),
+            write_packet(THREAD0_DISABLE, 0xFE),
+            write_packet(THREAD1_DISABLE, 0xFF),
+            write_packet(SOFT_RESET, 4, 4),
+            read_packet(IPI_REDIRECT_PC),
+            read_packet(MINION_BOOT),
+        ])
+        check(result[1] == bytes(8), "warm assertion ACK preceded ESR reset")
+        check(result[7] == struct.pack("<Q", PC_B), "batch release erased programmed warm ESR")
+        check(result[8] == struct.pack("<Q", PC_B), "batch release erased boot PC")
+        incrementing(client, DATA_B)
+        check(u64(client, IPI_REDIRECT_PC) == PC_B, "ESR reset deferred until after batch")
+        stable(client, DATA_A, "warm batch ran assertion/CLI PC")
+
+        # Cold reset must take effect before the next request programs boot
+        # and masks; otherwise a later deferred reset silently erases them.
+        result = pipeline(client, [
+            write_packet(SOFT_RESET, 0xE, 4),
+            read_packet(MINION_BOOT),
+            read_packet(THREAD0_DISABLE),
+            read_packet(SOFT_RESET, 4),
+            write_packet(MINION_BOOT, PC_B),
+            write_packet(IPI_REDIRECT_PC, PC_B),
+            write_packet(THREAD0_DISABLE, 0xFC),
+            write_packet(THREAD1_DISABLE, 0xFC),
+            write_packet(DATA_B, bytes(256)),
+            write_packet(SOFT_RESET, 4, 4),
+        ])
+        check(result[1] == struct.pack("<Q", BOOTROM), "cold ACK preceded boot-ESR reset")
+        check(result[2] == struct.pack("<Q", 0xFE), "cold ACK preceded mask reset")
+        check(result[3] == struct.pack("<I", 6), "cold pulse not cleared before ACK")
+        incrementing(client, DATA_B, (0, 1, 2, 3))
+        check(u64(client, MINION_BOOT) == PC_B, "cold reset erased subsequent batch boot write")
+        check(u64(client, THREAD0_DISABLE) == 0xFC, "cold reset erased subsequent batch mask")
+        check(u64(client, IPI_REDIRECT_PC) == PC_B, "cold reset erased subsequent batch warm ESR")
+
+        result = pipeline(client, [
+            write_packet(SOFT_RESET, 7, 4),
+            read_packet(MINION_BOOT),
+            read_packet(SOFT_RESET, 4),
+            write_packet(MINION_BOOT, PC_B),
+            write_packet(IPI_REDIRECT_PC, PC_B),
+            write_packet(THREAD0_DISABLE, 0xFE),
+            write_packet(THREAD1_DISABLE, 0xFF),
+            write_packet(DATA_B, bytes(256)),
+            write_packet(SOFT_RESET, 4, 4),
+        ])
+        check(result[1] == struct.pack("<Q", PC_A), "whole-reset ACK preceded CLI profile reset")
+        check(result[2] == struct.pack("<I", 6), "whole-reset ACK preceded held profile restore")
+        incrementing(client, DATA_B)
+        check(u64(client, MINION_BOOT) == PC_B, "whole reset erased subsequent batch boot write")
+        check(u32(client, SOFT_RESET) == 4, "whole reset deferred until after batch release")
+        stable(client, DATA_A, "whole-reset batch ran CLI image")
+
+
+def test_debug_cannot_release_hold(emu):
+    with backend(emu, True) as (client, _):
+        write(client, PC_B, counter_code(DATA_B))
+        write(client, DATA_B, bytes(256))
+        w64(client, MINION_BOOT, PC_B)
+        masks(client, 0xFC, 0xFC)
+        for _ in range(2):  # both startup hold and a hold asserted while running
+            w32(client, SOFT_RESET, 6)
+            stable(client, DATA_B, "CPU not held before debug probes")
+            w64(client, HACTRL, 0xF)
+            for assert_reset, release in ((0x20000001, 1),  # selected hartreset
+                                          (0x24000001, 0x04000001),  # all selected harts
+                                          (3, 1)):        # ndmreset
+                w64(client, DMCTRL, assert_reset)
+                w64(client, DMCTRL, release)
+                check(u32(client, SOFT_RESET) == 6, "debug release changed physical hold")
+                stable(client, DATA_B, "debug reset release bypassed physical warm hold")
+                check(u64(client, HASTATUS0) & 0xFFFFFFFF == 0,
+                      "debug reset release made held harts running/halted")
+
+            # Exercise direct debug halt/resume, reset-halt requests, and
+            # auto-execute program-buffer ESRs, not just thread-mask gating.
+            for command in (0x80000001, 0x40000001, 0x84000001,
+                            0x44000001, 0x10000001, 9, 1, 5, 1):
+                w64(client, DMCTRL, command)
+            w64(client, NXPROGBUF0, sd(6, 0))  # store would corrupt the held counter
+            w64(client, NXPROGBUF1, 0x00100073)  # ebreak
+            w64(client, ABSCMD, (0x00100313 << 32) | 0x400112B7)
+            w64(client, AXPROGBUF0, sd(6, 0))
+            w64(client, AXDATA0, 0)
+            w64(client, AXDATA1, 0)
+            w64(client, MINION_FEATURE, 0x11)  # disable multithreading
+            w64(client, MINION_FEATURE, 1)     # feature ESR also recomputes enables
+            masks(client, 0xFF, 0xFF)
+            masks(client, 0xFC, 0xFC)
+            stable(client, DATA_B, "debug/ESR start path executed while physically held")
+            check(u64(client, HASTATUS0) & 0xFFFFFFFF == 0, "held harts gained execution state")
+            check(u64(client, HASTATUS1) & 0xF == 0, "held harts entered executable program buffer")
+            w32(client, SOFT_RESET, 4)
+            incrementing(client, DATA_B, (0, 1, 2, 3))
+
+        # Independent debug ndmreset also cannot be cleared by a SoftReset
+        # release. Only releasing both reset sources makes the harts run.
+        w32(client, SOFT_RESET, 6)
+        w64(client, DMCTRL, 3)
+        w32(client, SOFT_RESET, 4)
+        stable(client, DATA_B, "SoftReset release bypassed asserted debug ndmreset")
+        w64(client, DMCTRL, 1)
+        incrementing(client, DATA_B, (0, 1, 2, 3))
+
+
