diff --git a/sw-sysemu/sw-sysemu/socket_agent.cpp b/sw-sysemu/sw-sysemu/socket_agent.cpp
index 6418ff5..b93a9df 100644
--- a/sw-sysemu/sw-sysemu/socket_agent.cpp
+++ b/sw-sysemu/sw-sysemu/socket_agent.cpp
@@ -343,6 +343,21 @@ void SocketAgent::handle_request(const erb_msg_hdr& hdr, const uint8_t* payload)
             break;
         }
         uint32_t st = do_write(hdr.addr, hdr.len, payload);
+        // process() runs outside the CPU instruction loop. Complete any MMIO
+        // reset before acknowledging this WRITE or handling the next request,
+        // even when a client pipelines several writes in one recv() buffer.
+        // CPU-originated writes still use the driver's safe cycle boundary.
+        try {
+            if (chip_) {
+                chip_->process_erbium_reset();
+            }
+        }
+        catch (const std::exception& e) {
+            if (agent_) {
+                LOG_AGENT(ERR, *agent_, "Reset after host WRITE failed: %s", e.what());
+            }
+            st = ERB_ST_SLVERR;
+        }
         send_response(hdr.op, st, hdr.addr, nullptr, 0);
         break;
     }
