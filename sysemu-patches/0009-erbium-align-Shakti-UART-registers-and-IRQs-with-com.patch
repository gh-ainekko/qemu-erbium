--- /dev/null
+++ b/sw-sysemu/tests/erbium/uart-registers/registers.cpp
@@ -0,0 +1,313 @@
+// SPDX-License-Identifier: Apache-2.0
+// Expected offsets, bits, reset values and duplication come from the compiled
+// ext/core-et-erbium/ip/uart/verilog/uart.v, not UART header constants.
+#include <array>
+#include <cassert>
+#include <iostream>
+#include <vector>
+#include <sys/ioctl.h>
+#include "system_mock.h"
+#include "devices/shakti_uart.h"
+
+using Uart = bemu::ShaktiUart<0x02004000, 0x1000, 3>;
+struct Fixture {
+    bemu::System chip;
+    bemu::Noagent agent{&chip};
+    Uart uart;
+    uint64_t rd(uint64_t offset, unsigned n = 8) {
+        // Deliberately unaligned, poisoned output with surrounding canaries.
+        std::array<uint8_t, 10> out;
+        out.fill(0xa5);
+        uart.read(agent, offset, n, out.data() + 1);
+        uint64_t value = 0;
+        for (unsigned i = 0; i < n; ++i) value |= uint64_t(out[i + 1]) << (8 * i);
+        assert(out[0] == 0xa5);
+        for (unsigned i = n + 1; i < out.size(); ++i) assert(out[i] == 0xa5);
+        return value;
+    }
+    void wr(uint64_t offset, uint64_t value, unsigned n = 4) {
+        std::array<uint8_t, 9> in{};
+        for (unsigned i = 0; i < n; ++i) in[i + 1] = value >> (8 * i);
+        uart.write(agent, offset, n, in.data() + 1);
+    }
+    void tick() { uart.clock_tick(agent, 30); }
+    uint16_t status() { return rd(0x18); }
+    void expect_error(uint64_t offset, bool writing, unsigned n = 4) {
+        bool caught = false;
+        try {
+            if (writing) wr(offset, 0xff, n);
+            else (void)rd(offset, n);
+        } catch (const bemu::memory_error& error) {
+            assert(error.addr == 0x02004000 + offset);
+            caught = true;
+        }
+        assert(caught);
+    }
+};
+struct Pipe {
+    int fds[2];
+    Pipe() {
+        assert(pipe(fds) == 0);
+        for (int fd : fds) {
+            int flags = fcntl(fd, F_GETFL);
+            assert(flags >= 0 && fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0);
+        }
+    }
+    ~Pipe() { close(fds[0]); close(fds[1]); }
+    void send(std::initializer_list<uint8_t> bytes) {
+        std::vector<uint8_t> data(bytes);
+        assert(::write(fds[1], data.data(), data.size()) == ssize_t(data.size()));
+    }
+    int waiting() {
+        int bytes = -1;
+        assert(ioctl(fds[0], FIONREAD, &bytes) == 0);
+        return bytes;
+    }
+    std::vector<uint8_t> drain() {
+        std::vector<uint8_t> bytes;
+        uint8_t data[4096];
+        for (;;) {
+            const ssize_t n = ::read(fds[0], data, sizeof(data));
+            if (n < 0) { assert(errno == EAGAIN); return bytes; }
+            assert(n > 0);
+            bytes.insert(bytes.end(), data, data + n);
+        }
+    }
+};
+
+static void reset_widths_and_access() {
+    Fixture f;
+    assert(f.rd(0x00) == 0x0005000500050005ULL);
+    assert(f.rd(0x20) == 0);
+    assert(f.rd(0x28) == 0x0100010001000100ULL); // 8-bit chars, no parity/stop bits
+    assert(f.rd(0x30) == 0);
+    assert(f.rd(0x38) == 0x0505050505050505ULL); // compiled reset is 5, not 24
+    assert(f.rd(0x18) == 0x0001000100010001ULL);
+    assert(f.rd(0x10) == 0 && f.rd(0x48) == 0 && f.rd(0x50) == 0 && f.rd(0x58) == 0);
+    assert(!f.chip.irq);
+    f.wr(0x00, 0x1234abcd);
+    assert(f.rd(0x00) == 0xabcdabcdabcdabcdULL);
+    assert(f.rd(0x00, 4) == 0xabcdabcd && f.rd(0x00, 2) == 0xabcd);
+    assert(f.rd(0x00, 1) == 0xcd);
+    f.wr(0x20, ~0ULL);
+    assert(f.rd(0x20) == ~0ULL);
+    f.wr(0x28, ~0ULL);
+    assert(f.rd(0x28) == 0x07fe07fe07fe07feULL); // no modem/stick parity
+    f.wr(0x30, 0x12345678);
+    assert(f.rd(0x30) == 0x7878787878787878ULL);
+    f.wr(0x38, ~0ULL);
+    assert(f.rd(0x38) == 0x1f1f1f1f1f1f1f1fULL); // five-bit field, no FIFO-clear
+    f.wr(0x50, ~0ULL, 8);
+    assert(f.rd(0x50) == 0x03ff03ff03ff03ffULL);
+    f.wr(0x48, ~0ULL, 8);
+    assert(f.rd(0x48) == 0x3ff && f.rd(0x58) == 0x3ff); // zero-extended, not duplicated
+    assert(f.rd(0x48) == 0x3ff); // no read-clear
+    assert(f.chip.irq);
+    f.wr(0x50, 0);
+    assert(!f.chip.irq && f.rd(0x48) == 0x3ff && f.rd(0x58) == 0);
+    // RTL address aliasing after top-level address >> 1.
+    assert(f.rd(0x80) == f.rd(0x00) && f.rd(0x81) == f.rd(0x00));
+    f.expect_error(0x08, false); // TX is not a peer extraction register
+    f.expect_error(0x10, true);  // RX is not a peer injection register
+    f.expect_error(0x58, true);
+    f.expect_error(0x40, false);
+    f.expect_error(0x40, true);
+    f.expect_error(0x02, false);
+    f.expect_error(0x00, false, 0);
+    f.expect_error(0x00, true, 3);
+    // Narrow source buffer: do not read four bytes for a one-byte access.
+    const uint8_t byte = 0x34;
+    f.uart.write(f.agent, 0, 1, &byte);
+    assert(f.rd(0, 2) == 0x34);
+    std::cout << "PASS compiled reset, field widths, register replication, unaligned/narrow MMIO, decode/access\n";
+}
+
+static void raw_mask_status_and_tx_polarity() {
+    Fixture f;
+    f.chip.enabled = false;
+    f.wr(0x30, 0xff); // IQC must not enable IRQ
+    f.tick();
+    assert(f.rd(0x48) == 3); // empty TX and TX *not* full, captured even with mask/pads off
+    assert(f.rd(0x50) == 0 && f.rd(0x58) == 0 && !f.chip.irq);
+    f.wr(0x50, 2);
+    assert(f.rd(0x58) == 2 && f.chip.irq);
+    const unsigned clears = f.chip.clears;
+    f.wr(0x50, 0);
+    assert(!f.chip.irq && f.chip.clears == clears + 1);
+    f.tick();
+    assert(!f.chip.irq && f.rd(0x48) == 3);
+    f.wr(0x50, 2);
+    assert(f.chip.irq); // old raw survives mask toggling
+    f.wr(0x48, 2);
+    assert(f.rd(0x48) == 1 && !f.chip.irq);
+    f.wr(0x48, 2);
+    assert(f.rd(0x48) == 3 && f.chip.irq); // XOR sets a zero bit, unlike W1C
+    f.wr(0x48, 2);
+    f.uart.clock_tick(f.agent, 29);
+    assert(!f.chip.irq); // no capture until peripheral clock tick
+    f.tick();
+    assert(f.chip.irq); // still-active condition relatches
+
+    f.uart.reset(f.agent);
+    f.wr(0x48, 0x200);
+    f.wr(0x50, 0x200);
+    assert(f.rd(0x58) == 0x200 && !f.chip.irq); // no modem IRQ bit 9 output
+    f.wr(0x48, 0x400);
+    assert(f.rd(0x48) == 0x200); // bit 10 ignored
+    f.tick();
+    assert(!f.chip.irq);
+
+    f.uart.reset(f.agent);
+    f.chip.enabled = true;
+    f.wr(0x50, 2);
+    for (unsigned i = 0; i < 16; ++i) f.wr(0x08, i);
+    assert(f.status() == 2); // live full is not the IRQ condition
+    f.tick(); // no TX peer => lossless retention under backpressure
+    assert(f.rd(0x48) == 0 && !f.chip.irq);
+    f.wr(0x48, 2); // software can set raw even while condition inactive
+    assert(f.chip.irq);
+    f.wr(0x48, 2);
+    f.tick();
+    assert(!f.chip.irq && f.rd(0x48) == 0);
+    std::cout << "PASS IQC versus mask, sticky RAW/XOR, mask-zero PLIC clear, TX-not-full IRQ, no modem IRQ\n";
+}
+
+static void rx_threshold_sticky_and_ack() {
+    Fixture f;
+    Pipe p;
+    f.uart.rx_fd = p.fds[0];
+    p.send({1, 2, 3, 4});
+    assert(f.status() == 5); // occupancy four, reset threshold five
+    f.tick();
+    assert(f.rd(0x48) == 7);
+    p.send({5});
+    assert(f.status() == 0x105); // inclusive count >= threshold
+    f.tick();
+    f.wr(0x50, 0x100);
+    assert(f.chip.irq && f.rd(0x58) == 0x100);
+    for (unsigned i = 1; i <= 5; ++i) assert(f.rd(0x10) == (uint64_t(i) << 32 | i));
+    assert(f.status() == 0x101); // threshold stays after empty
+    assert(f.chip.irq && f.rd(0x48) == 0x107); // RX-not-empty raw also stays
+    f.wr(0x18, 0x100); // ones retain, zero clears
+    assert(f.status() == 0x101);
+    f.wr(0x18, 0);
+    assert(f.status() == 1 && f.chip.irq); // clearing STATUS doesn't acknowledge RAW
+    f.wr(0x48, 0x100);
+    assert(!f.chip.irq && f.rd(0x58) == 0);
+    f.tick();
+    assert(!f.chip.irq); // no threshold source remains
+    f.wr(0x50, 4);
+    assert(f.chip.irq); // drained RX's sticky raw must be acknowledged separately
+    f.wr(0x48, 4);
+    assert(!f.chip.irq);
+    f.tick();
+    assert(!f.chip.irq);
+
+    f.wr(0x38, 0); // zero threshold includes an *empty* FIFO
+    f.tick();
+    assert(f.status() == 0x101);
+    f.wr(0x18, 0);
+    assert(f.status() == 0x101); // concurrent occupancy set wins a clear
+    f.wr(0x38, 31);
+    f.wr(0x18, 0);
+    assert(f.status() == 1);
+    p.send({0, 0xff, 0x11, 0x13});
+    assert(f.status() == 5);
+    f.wr(0x38, 0xe0 | 5); // conditional modem FIFO-clear controls are absent
+    assert(f.rd(0x38, 1) == 5 && (f.status() & 4));
+    assert(f.rd(0x10, 4) == 0 && f.rd(0x10, 4) == 0xff);
+    assert(f.rd(0x10, 4) == 0x11 && f.rd(0x10, 4) == 0x13);
+    std::cout << "PASS inclusive/sticky RX threshold, AND-to-clear STATUS, RAW independence, no modem FIFO clears\n";
+}
+
+static void pad_routing_and_reset_independence() {
+    Fixture f;
+    Pipe rx, tx;
+    f.uart.rx_fd = rx.fds[0];
+    f.uart.tx_fd = tx.fds[1];
+    f.chip.enabled = false;
+    rx.send({0x41, 0x42});
+    f.wr(0x08, 0x99);
+    assert(f.status() == 0 && rx.waiting() == 2); // write accepted with pads disabled
+    f.tick();
+    assert(tx.waiting() == 0 && f.status() == 1 && rx.waiting() == 2);
+    assert(f.rd(0x10) == 0); // no RX crosses disabled pads
+    f.chip.enabled = true;
+    f.chip.cpu_warm_held = true;
+    f.wr(0x00, 0x123);
+    f.wr(0x50, 4);
+    f.wr(0x08, 0xa5);
+    f.tick(); // CPU hold must not prevent independent peripheral operation
+    assert(tx.drain() == std::vector<uint8_t>{0xa5}); // disabled-pad 0x99 NOT replayed
+    assert(f.chip.irq && f.rd(0x00, 2) == 0x123);
+    f.chip.enabled = false;
+    assert(f.rd(0x10, 4) == 0x41); // prior internal RX still CPU/host readable
+    assert(f.rd(0x10, 4) == 0x42);
+    assert(f.chip.irq); // pinmux/CPU hold does not clear raw
+    f.chip.cpu_warm_held = false;
+    assert(f.rd(0x00, 2) == 0x123 && f.chip.irq);
+
+    f.chip.enabled = true;
+    rx.send({1, 2, 3, 4, 5});
+    assert(f.status() == 0x105); // internal RX and sticky threshold to reset
+    f.wr(0x20, 0x1234);
+    f.wr(0x28, 0x7fe);
+    f.wr(0x30, 0x23);
+    f.wr(0x08, 0xee); // queued TX reset should not leak onto peer
+    f.uart.reset(f.agent);
+    assert(!f.chip.irq);
+    assert(f.uart.tx_fd == tx.fds[1] && f.uart.rx_fd == rx.fds[0]);
+    assert(f.rd(0x00, 2) == 5 && f.rd(0x28, 2) == 0x100 && f.rd(0x38, 1) == 5);
+    assert(f.rd(0x48) == 0 && f.rd(0x50) == 0 && f.rd(0x10) == 0 && f.status() == 1);
+    assert(f.rd(0x20) == 0 && f.rd(0x30) == 0 && f.rd(0x58) == 0);
+    f.chip.enabled = true;
+    f.tick();
+    assert(tx.waiting() == 0);
+    rx.send({0x5a});
+    f.wr(0x08, 0x7e);
+    f.tick();
+    assert(f.rd(0x10, 4) == 0x5a && tx.drain() == std::vector<uint8_t>{0x7e});
+    std::cout << "PASS pad-only routing, independent CPU hold, chip-reset defaults/FIFOs/PLIC, fd preservation\n";
+}
+
+static void bounded_lossless_stream() {
+    Fixture f;
+    Pipe rx, tx;
+    f.uart.rx_fd = rx.fds[0];
+    f.uart.tx_fd = tx.fds[1];
+    std::vector<uint8_t> bytes(32);
+    for (unsigned i = 0; i < bytes.size(); ++i) bytes[i] = i * 7;
+    assert(::write(rx.fds[1], bytes.data(), bytes.size()) == ssize_t(bytes.size()));
+    assert(f.status() == 0x10d);
+    assert(rx.waiting() == 16);
+    f.tick();
+    f.wr(0x50, 8); // RX full positive source, sticky through draining
+    assert(f.rd(0x58) == 8 && f.chip.irq);
+    for (unsigned i = 0; i < 100; ++i) f.tick();
+    assert(rx.waiting() == 16 && !(f.status() & 0xf0)); // no fabricated overrun/errors
+    for (uint8_t byte : bytes) assert(f.rd(0x10, 4) == byte);
+    assert(rx.waiting() == 0 && !(f.status() & 0x0c));
+    assert(f.chip.irq && f.rd(0x58) == 8);
+    f.wr(0x48, 8);
+    assert(!f.chip.irq);
+    std::array<uint8_t, 4096> filler{};
+    while (::write(tx.fds[1], filler.data(), filler.size()) > 0) {}
+    assert(errno == EAGAIN);
+    for (unsigned i = 0; i < 16; ++i) f.wr(0x08, bytes[i]);
+    f.tick();
+    assert(f.status() & 2); // actual EAGAIN retains FIFO and TX_FULL
+    tx.drain();
+    f.tick();
+    assert((f.status() & 3) == 1);
+    bytes.resize(16);
+    assert(tx.drain() == bytes);
+    std::cout << "PASS bounded RX host backpressure, binary byte order, no fake overrun, TX EAGAIN/resume\n";
+}
+
+int main() {
+    reset_widths_and_access();
+    raw_mask_status_and_tx_polarity();
+    rx_threshold_sticky_and_ack();
+    pad_routing_and_reset_independence();
+    bounded_lossless_stream();
+}
