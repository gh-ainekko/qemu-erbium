+// SPDX-License-Identifier: Apache-2.0
+// Only stub the System/PLIC boundary; compile the production UART and Agent.
+#ifndef UART_REGISTER_SYSTEM_MOCK_H
+#define UART_REGISTER_SYSTEM_MOCK_H
+#include <cassert>
+#include <cstdint>
+#define BEMU_SYSTEM_H
+namespace bemu {
+class System {
+public:
+    bool enabled = true;
+    bool cpu_warm_held = false;
+    bool irq = false;
+    unsigned sets = 0, clears = 0;
+    bool is_uart_enabled() const { return enabled; }
+    void er_plic_interrupt_pending_set(uint32_t source) {
+        assert(source == 3);
+        irq = true;
+        ++sets;
+    }
+    void er_plic_interrupt_pending_clear(uint32_t source) {
+        assert(source == 3);
+        irq = false;
+        ++clears;
+    }
+};
+}
+#endif
