+#!/usr/bin/env bash
+# SPDX-License-Identifier: Apache-2.0
+# Standalone native test; no backend build or cross compiler required.
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+SYSEMU=$(cd "$HERE/../../.." && pwd)
+OUT=${UART_REGISTER_BUILD:-"$(mktemp -d /tmp/shakti-uart-registers.XXXXXX)"}
+mkdir -p "$OUT"
+"${CXX:-c++}" -std=c++17 -O1 -g -Wall -Wextra -Werror -DERBIUM \
+  -fsanitize=address,undefined -fno-omit-frame-pointer -pthread \
+  -I"$SYSEMU" -I"$SYSEMU/../erbium-hal/include" "$HERE/registers.cpp" -o "$OUT/registers"
+ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 \
+  timeout 10 "$OUT/registers" | tee "$OUT/registers.log"
+printf 'Test artifacts: %s\n' "$OUT"
