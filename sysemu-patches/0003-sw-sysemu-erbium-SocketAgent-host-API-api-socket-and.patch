index 0000000..6418ff5
--- /dev/null
+++ b/sw-sysemu/sw-sysemu/socket_agent.cpp
@@ -0,0 +1,531 @@
+/*-------------------------------------------------------------------------
+* Copyright (c) 2026 Ainekko, Co.
+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+
+#include "socket_agent.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cinttypes>
+#include <csignal>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "emu_gio.h"
+#include "memory/main_memory.h"
+#include "memory/memory_error.h"
+#include "sys_emu.h"
+#include "system.h"
+
+#include <hwinc/top.h>
+
+namespace {
+
+volatile sig_atomic_t g_stop_requested = 0;
+
+void stop_signal_handler(int)
+{
+    g_stop_requested = 1;
+}
+
+void install_stop_handlers()
+{
+    struct sigaction sa;
+    std::memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = stop_signal_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0; // no SA_RESTART: interrupt a blocking poll()
+    sigaction(SIGINT, &sa, nullptr);
+    sigaction(SIGTERM, &sa, nullptr);
+    // Writing to a socket whose peer has gone must not kill the emulator
+    signal(SIGPIPE, SIG_IGN);
+}
+
+void set_nonblocking(int fd)
+{
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags >= 0)
+        fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+}
+
+} // namespace
+
+
+SocketAgent::SocketAgent(const std::string& path)
+    : path_(path)
+{
+    struct sockaddr_un addr;
+    if (path.size() >= sizeof(addr.sun_path)) {
+        throw std::runtime_error("SocketAgent: socket path too long: " + path);
+    }
+
+    listen_fd_ = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (listen_fd_ < 0) {
+        throw std::runtime_error(std::string("SocketAgent: socket(): ") + std::strerror(errno));
+    }
+
+    // Remove a stale socket file from a previous run
+    ::unlink(path.c_str());
+
+    std::memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    std::strncpy(addr.sun_path, path.c_str(), sizeof(addr.sun_path) - 1);
+    if (::bind(listen_fd_, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) != 0) {
+        int err = errno;
+        ::close(listen_fd_);
+        listen_fd_ = -1;
+        throw std::runtime_error("SocketAgent: bind('" + path + "'): " + std::strerror(err));
+    }
+    if (::listen(listen_fd_, 1) != 0) {
+        int err = errno;
+        ::close(listen_fd_);
+        listen_fd_ = -1;
+        ::unlink(path.c_str());
+        throw std::runtime_error("SocketAgent: listen(): " + std::string(std::strerror(err)));
+    }
+    set_nonblocking(listen_fd_);
+
+    rx_buf_.reserve(sizeof(erb_msg_hdr) + ERB_MAX_LEN);
+    tx_buf_.reserve(sizeof(erb_msg_hdr) + ERB_MAX_LEN);
+
+    install_stop_handlers();
+}
+
+
+SocketAgent::~SocketAgent()
+{
+    drop_client();
+    if (listen_fd_ >= 0) {
+        ::close(listen_fd_);
+        listen_fd_ = -1;
+    }
+    ::unlink(path_.c_str());
+}
+
+
+void SocketAgent::set_system(bemu::System* system)
+{
+    chip_ = system;
+    agent_ = std::make_unique<bemu::Noagent>(chip_, "SocketAgent");
+    LOG_AGENT(INFO, *agent_, "Listening on UNIX socket \"%s\"", path_.c_str());
+}
+
+
+bool SocketAgent::raise_host_interrupt(uint32_t)
+{
+    // No out-of-band host event line in protocol v1 (host polls Mailbox1)
+    return false;
+}
+
+
+bool SocketAgent::host_memory_read(uint64_t, uint64_t, void*)
+{
+    // Erbium has no DMA into host memory
+    return false;
+}
+
+
+bool SocketAgent::host_memory_write(uint64_t, uint64_t, const void*)
+{
+    return false;
+}
+
+
+void SocketAgent::notify_iatu_ctrl_2_reg_write(int, uint32_t, uint32_t)
+{
+}
+
+
+// Called by testLog on a FATAL message (the message itself has already been
+// printed). Standalone sys_emu ends the simulation here; when serving a host
+// we behave like wedged silicon instead: the harts go offline and the socket
+// keeps being served so the host can inspect state and issue a POR.
+// Note: this runs from inside the logger, possibly in the middle of the hart
+// loop, so it must not log through testLog nor unlink harts synchronously.
+// testLog keeps its fatal flag set forever, so this is invoked again for
+// every later message: only react when there is something to stop.
+void SocketAgent::notify_fatal_error(const std::string& error)
+{
+    if (emu_) {
+        if (emu_->stop_all_harts()) {
+            std::cerr << "erbium_emu: fatal error in chip model" << (error.empty() ? "" : ": ") << error
+                      << " - harts taken offline, still serving " << path_ << std::endl;
+        }
+    } else if (chip_) {
+        chip_->set_emu_done(true, true);
+    }
+}
+
+
+// ---------------------------------------------------------------------------
+// Connection handling
+// ---------------------------------------------------------------------------
+
+void SocketAgent::accept_client()
+{
+    int fd = ::accept4(listen_fd_, nullptr, nullptr, SOCK_CLOEXEC);
+    if (fd < 0) {
+        return; // EAGAIN or transient error: try again next iteration
+    }
+    set_nonblocking(fd);
+    client_fd_ = fd;
+    rx_buf_.clear();
+    if (agent_) {
+        LOG_AGENT(INFO, *agent_, "%s", "Host connected");
+    }
+}
+
+
+void SocketAgent::drop_client()
+{
+    if (client_fd_ >= 0) {
+        ::close(client_fd_);
+        client_fd_ = -1;
+        rx_buf_.clear();
+        if (agent_) {
+            LOG_AGENT(INFO, *agent_, "%s", "Host disconnected");
+        }
+    }
+}
+
+
+// Pull everything currently readable into rx_buf_. Returns false when the
+// peer closed the connection or a hard error occurred.
+bool SocketAgent::read_client()
+{
+    for (;;) {
+        uint8_t tmp[8192];
+        ssize_t n = ::recv(client_fd_, tmp, sizeof(tmp), 0);
+        if (n > 0) {
+            rx_buf_.insert(rx_buf_.end(), tmp, tmp + n);
+            // Service what we have before reading more, keeping the
+            // reassembly buffer small.
+            handle_requests();
+            if (client_fd_ < 0) {
+                return false;
+            }
+            continue;
+        }
+        if (n == 0) {
+            return false; // orderly shutdown
+        }
+        if (errno == EINTR) {
+            continue;
+        }
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            return true;
+        }
+        return false;
+    }
+}
+
+
+void SocketAgent::process()
+{
+    if (g_stop_requested) {
+        g_stop_requested = 0;
+        if (agent_) {
+            LOG_AGENT(INFO, *agent_, "%s", "Stop requested by signal");
+        }
+        if (chip_) {
+            chip_->set_emu_done(true);
+        }
+        return;
+    }
+
+    if (client_fd_ < 0) {
+        accept_client();
+        if (client_fd_ < 0) {
+            return;
+        }
+    }
+
+    if (!read_client()) {
+        drop_client();
+    }
+}
+
+
+void SocketAgent::idle_wait()
+{
+    struct pollfd pfd;
+    pfd.fd = (client_fd_ >= 0) ? client_fd_ : listen_fd_;
+    pfd.events = POLLIN;
+    pfd.revents = 0;
+    if (pfd.fd < 0) {
+        return;
+    }
+    // Block for up to 1 ms; readiness is serviced by the next process().
+    ::poll(&pfd, 1, 1);
+}
+
+
+// ---------------------------------------------------------------------------
+// Protocol
+// ---------------------------------------------------------------------------
+
+void SocketAgent::handle_requests()
+{
+    size_t pos = 0;
+    while (client_fd_ >= 0 && rx_buf_.size() - pos >= sizeof(erb_msg_hdr)) {
+        erb_msg_hdr hdr;
+        std::memcpy(&hdr, rx_buf_.data() + pos, sizeof(hdr));
+
+        if (hdr.magic != ERB_MAGIC || hdr.version != ERB_VERSION || hdr.len > ERB_MAX_LEN) {
+            // We cannot resynchronise a stream with a corrupt header: answer
+            // BADREQ and drop the connection.
+            if (agent_) {
+                LOG_AGENT(WARN, *agent_, "Bad request header (magic=0x%08" PRIx32
+                          " version=%u op=%u len=%u): dropping client",
+                          hdr.magic, hdr.version, hdr.op, hdr.len);
+            }
+            send_response(hdr.op, ERB_ST_BADREQ, hdr.addr, nullptr, 0);
+            drop_client();
+            return;
+        }
+
+        uint32_t payload_len = (hdr.op == ERB_OP_WRITE) ? hdr.len : 0;
+        if (rx_buf_.size() - pos < sizeof(hdr) + payload_len) {
+            break; // partial message: wait for more data
+        }
+
+        handle_request(hdr, rx_buf_.data() + pos + sizeof(hdr));
+        pos += sizeof(hdr) + payload_len;
+    }
+    if (pos > 0 && client_fd_ >= 0) {
+        rx_buf_.erase(rx_buf_.begin(), rx_buf_.begin() + pos);
+    }
+}
+
+
+void SocketAgent::handle_request(const erb_msg_hdr& hdr, const uint8_t* payload)
+{
+    ++requests_;
+    switch (hdr.op) {
+    case ERB_OP_PING: {
+        erb_info info;
+        std::memset(&info, 0, sizeof(info));
+        info.proto_version = ERB_VERSION;
+        info.flags = 0;
+        info.mram_base = ERBIUM_TOP_MRAM_BASE;
+        info.mram_size = ERBIUM_TOP_MRAM_SIZE;
+        std::strncpy(info.name, "erbium_emu", sizeof(info.name) - 1);
+        send_response(hdr.op, ERB_ST_OK, 0, &info, sizeof(info));
+        break;
+    }
+
+    case ERB_OP_READ: {
+        if (hdr.len < 1 || hdr.len > ERB_MAX_LEN) {
+            send_response(hdr.op, ERB_ST_BADREQ, hdr.addr, nullptr, 0);
+            break;
+        }
+        uint8_t data[ERB_MAX_LEN];
+        uint32_t st = do_read(hdr.addr, hdr.len, data);
+        if (st == ERB_ST_OK) {
+            send_response(hdr.op, st, hdr.addr, data, hdr.len);
+        } else {
+            send_response(hdr.op, st, hdr.addr, nullptr, 0);
+        }
+        break;
+    }
+
+    case ERB_OP_WRITE: {
+        if (hdr.len < 1 || hdr.len > ERB_MAX_LEN) {
+            send_response(hdr.op, ERB_ST_BADREQ, hdr.addr, nullptr, 0);
+            break;
+        }
+        uint32_t st = do_write(hdr.addr, hdr.len, payload);
+        send_response(hdr.op, st, hdr.addr, nullptr, 0);
+        break;
+    }
+
+    case ERB_OP_RESET: {
+        uint32_t st = do_reset(hdr.addr);
+        send_response(hdr.op, st, hdr.addr, nullptr, 0);
+        break;
+    }
+
+    default:
+        if (agent_) {
+            LOG_AGENT(WARN, *agent_, "Unknown request op %u", hdr.op);
+        }
+        send_response(hdr.op, ERB_ST_BADREQ, hdr.addr, nullptr, 0);
+        break;
+    }
+}
+
+
+bool SocketAgent::send_response(uint16_t op, uint32_t status, uint64_t addr,
+                                const void* payload, uint32_t len)
+{
+    if (client_fd_ < 0) {
+        return false;
+    }
+    erb_msg_hdr hdr;
+    hdr.magic = ERB_MAGIC;
+    hdr.version = ERB_VERSION;
+    hdr.op = static_cast<uint16_t>(op | ERB_OP_RESP);
+    hdr.status = status;
+    hdr.len = len;
+    hdr.addr = addr;
+
+    tx_buf_.resize(sizeof(hdr) + len);
+    std::memcpy(tx_buf_.data(), &hdr, sizeof(hdr));
+    if (len) {
+        std::memcpy(tx_buf_.data() + sizeof(hdr), payload, len);
+    }
+    if (!send_all(tx_buf_.data(), tx_buf_.size())) {
+        drop_client();
+        return false;
+    }
+    return true;
+}
+
+
+// Blocking send of the whole buffer on the non-blocking client socket.
+bool SocketAgent::send_all(const void* data, size_t n)
+{
+    const uint8_t* p = static_cast<const uint8_t*>(data);
+    while (n > 0) {
+        ssize_t w = ::send(client_fd_, p, n, MSG_NOSIGNAL);
+        if (w > 0) {
+            p += w;
+            n -= static_cast<size_t>(w);
+            continue;
+        }
+        if (w < 0 && errno == EINTR) {
+            continue;
+        }
+        if (w < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            struct pollfd pfd;
+            pfd.fd = client_fd_;
+            pfd.events = POLLOUT;
+            pfd.revents = 0;
+            if (::poll(&pfd, 1, 1000) <= 0 && errno != EINTR) {
+                return false;
+            }
+            continue;
+        }
+        return false;
+    }
+    return true;
+}
+
+
+// ---------------------------------------------------------------------------
+// Memory access
+// ---------------------------------------------------------------------------
+
+// Walks [addr, addr+n) splitting the access at region boundaries and, inside
+// register regions, into naturally aligned 4/8-byte units that the region
+// accepts. @op(chunk_addr, chunk_len, offset) performs one access.
+template<typename F>
+uint32_t SocketAgent::access(uint64_t addr, uint32_t n, F&& op)
+{
+    if (!chip_ || !agent_) {
+        return ERB_ST_SLVERR;
+    }
+    try {
+        uint64_t cur = addr;
+        uint32_t off = 0;
+        while (off < n) {
+            bemu::MainMemory::addr_type region_last = 0;
+            unsigned sizes = chip_->memory.access_sizes(cur, &region_last);
+            uint64_t remaining = n - off;
+            uint64_t to_end = region_last - cur + 1;
+            uint64_t chunk = std::min<uint64_t>(remaining, to_end);
+
+            if (sizes != 0) {
+                // Register region: pick the largest accepted unit that fits
+                // the alignment of the address and the remaining length.
+                unsigned unit = 0;
+                for (unsigned s = 8; s >= 1; s >>= 1) {
+                    if ((sizes & (1u << s)) && (cur % s) == 0 && (chunk % s) == 0) {
+                        unit = s;
+                        break;
+                    }
+                }
+                if (unit == 0) {
+                    if (agent_) {
+                        LOG_AGENT(WARN, *agent_, "Misaligned/odd-size register access at 0x%" PRIx64
+                                  " (%" PRIu64 " bytes)", cur, chunk);
+                    }
+                    return ERB_ST_SLVERR;
+                }
+                for (uint64_t i = 0; i < chunk; i += unit) {
+                    op(cur + i, unit, off + static_cast<uint32_t>(i));
+                }
+            } else {
+                op(cur, chunk, off);
+            }
+            cur += chunk;
+            off += static_cast<uint32_t>(chunk);
+        }
+        return ERB_ST_OK;
+    }
+    catch (const bemu::memory_error& e) {
+        if (agent_) {
+            LOG_AGENT(WARN, *agent_, "Host access to unmapped address 0x%" PRIx64, e.addr);
+        }
+        return ERB_ST_DECERR;
+    }
+    catch (const std::exception& e) {
+        if (agent_) {
+            LOG_AGENT(WARN, *agent_, "Host access at 0x%" PRIx64 " failed: %s", addr, e.what());
+        }
+        return ERB_ST_SLVERR;
+    }
+}
+
+
+uint32_t SocketAgent::do_read(uint64_t addr, uint32_t n, uint8_t* out)
+{
+    return access(addr, n, [&](uint64_t a, uint64_t len, uint32_t off) {
+        chip_->memory.read(*agent_, a, len, out + off);
+    });
+}
+
+
+uint32_t SocketAgent::do_write(uint64_t addr, uint32_t n, const uint8_t* in)
+{
+    return access(addr, n, [&](uint64_t a, uint64_t len, uint32_t off) {
+        chip_->memory.write(*agent_, a, len, in + off);
+    });
+}
+
+
+uint32_t SocketAgent::do_reset(uint64_t kind)
+{
+    switch (kind) {
+    case 0: // POR: whole chip
+        if (emu_) {
+            try {
+                emu_->por_reset();
+            }
+            catch (const std::exception& e) {
+                if (agent_) {
+                    LOG_AGENT(ERR, *agent_, "POR reset failed: %s", e.what());
+                }
+                return ERB_ST_SLVERR;
+            }
+        } else if (agent_) {
+            LOG_AGENT(WARN, *agent_, "%s", "POR reset requested but no driver attached: ignored");
+        }
+        return ERB_ST_OK;
+    case 1: // xSPI-only: nothing to do on the CPU side
+        return ERB_ST_OK;
+    default:
+        if (agent_) {
+            LOG_AGENT(WARN, *agent_, "Unknown reset kind %" PRIu64, kind);
+        }
+        return ERB_ST_BADREQ;
+    }
+}
