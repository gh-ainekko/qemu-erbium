+/*-------------------------------------------------------------------------
+* Copyright (c) 2026 Ainekko, Co.
+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+
+#ifndef _SOCKET_AGENT_H_
+#define _SOCKET_AGENT_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "api_communicate.h"
+#include "agent.h"
+
+class sys_emu;
+
+namespace bemu {
+class System;
+}
+
+// api_communicate implementation that serves the QEMU <-> erbium_emu control
+// protocol (docs/protocol.md) over a listening UNIX stream socket.
+//
+// The host (QEMU's erbium-xspi device) is the only requester; every request
+// is answered synchronously from process(), which the emulator main loop
+// calls once per iteration. Requests are memory accesses in the CPU address
+// map, forwarded to bemu::MainMemory with a Noagent, plus PING and RESET.
+class SocketAgent : public api_communicate {
+public:
+    // Protocol constants (keep in sync with docs/protocol.md)
+    static constexpr uint32_t ERB_MAGIC      = 0x42524555; // 'UERB'
+    static constexpr uint16_t ERB_VERSION    = 1;
+    static constexpr uint16_t ERB_OP_PING    = 1;
