@@ -0,0 +1,52 @@
+/*-------------------------------------------------------------------------
+* Copyright (c) 2026 Ainekko, Co.
+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+
+#ifndef SYSEMU_UART_SOCKET_H
+#define SYSEMU_UART_SOCKET_H
+
+#include <csignal>
+#include <functional>
+#include <string>
+#include <sys/types.h>
+
+// Owned serial-peer transport, NOT a host MMIO/xSPI API. The UART borrows the
+// same nonblocking descriptor for RX and TX; this class never reads/writes bytes.
+class UartSocket {
+public:
+    // attach(-1) must detach BOTH directions and service the UART FD interface
+    // before returning, so its cached descriptor state is invalidated before
+    // close()/accept4() can reuse a descriptor number. Must not throw on detach.
+    using Attach = std::function<void(int)>;
+    UartSocket(const std::string& path, Attach attach);
+    ~UartSocket();
+    UartSocket(const UartSocket&) = delete;
+    UartSocket& operator=(const UartSocket&) = delete;
+
+    void process();
+    void idle_wait();
+    bool stop_requested() const;
+    bool has_client() const { return client_fd_ >= 0; }
+    // Include aliases of an existing parent directory (relative paths, ".",
+    // directory symlinks), even though the socket itself does not exist yet.
+    static bool same_path(const std::string& a, const std::string& b);
+
+private:
+    void drop_client();
+    void cleanup();
+
+    std::string path_;
+    Attach attach_;
+    int listen_fd_ = -1;
+    int client_fd_ = -1;
+    dev_t path_dev_ = 0;
+    ino_t path_ino_ = 0;
+    bool owns_path_ = false;
+    struct sigaction old_int_{};
+    struct sigaction old_term_{};
+    bool installed_int_ = false;
+    bool installed_term_ = false;
+};
+
+#endif
