+#!/usr/bin/env python3
+# Copyright (c) 2026 Ainekko, Co.
+# SPDX-License-Identifier: Apache-2.0
+"""Endpoint integration, separate from UART register-fidelity regressions.
+
+python3 test_uart_endpoint.py --emu /path/to/erbium_emu
+
+No guest image/cross compiler/pytest. MMIO is exercised through the existing
+xSPI backend test client solely to drive/assert the independent serial wiring.
+This is not the Linux UART1/Kotama end-to-end acceptance test.
+"""
+
+import argparse
+import contextlib
+from pathlib import Path
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "tools"))
+from erb_client import ErbClient  # noqa: E402
+
+DEADLINE = 5
+CONFIG = 0x02000008
+SOFT_RESET = 0x02000028
+MINION_BOOT = 0x80D00018
+TX = 0x02004008
+RX = 0x02004010
+STATUS = 0x02004018
+BAUD = 0x02004000
+CODE = 0x40001000
+SENTINEL = 0x40010000
+
+
+def check(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def until(predicate, message):
+    deadline = time.monotonic() + DEADLINE
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(0.005)
+    raise AssertionError("timeout: " + message)
+
+
+def read(client, addr, size):
+    status, data = client.read(addr, size)
+    check(status == 0 and len(data) == size, f"MMIO read {addr:#x}: status {status}")
+    return data
+
+
+def w32(client, addr, value):
+    check(client.write(addr, struct.pack("<I", value)) == 0, f"MMIO write {addr:#x}")
+
+
+def u32(client, addr):
+    return struct.unpack("<I", read(client, addr, 4))[0]
+
+
+def enable_pads(client):
+    w32(client, CONFIG, u32(client, CONFIG) | 64)
+    # Device-side disconnected-pad backlog discard/reenable is serviced on a
+    # peripheral tick; do not race incoming test data with that pinmux edge.
+    time.sleep(0.1)
+
+
+def connect(path):
+    peer = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    peer.settimeout(DEADLINE)
+    peer.connect(str(path))
+    return peer
+
+
+def receive(peer, size):
+    data = b""
+    while len(data) < size:
+        chunk = peer.recv(size - len(data))
+        check(bool(chunk), "serial peer unexpectedly closed")
+        data += chunk
+    return data
+
+
+def serial_rx(client, payload):
+    data = bytearray()
+    for _ in payload:
+        until(lambda: u32(client, STATUS) & 4, "UART RX byte")
+        data.append(u32(client, RX) & 255)
+    check(bytes(data) == payload, "UART input is not byte-transparent")
+
+
+def serial_tx(client, peer, payload):
+    for byte in payload:
+        until(lambda: not (u32(client, STATUS) & 2), "UART TX space")
+        w32(client, TX, byte)
+    check(receive(peer, len(payload)) == payload, "UART output is not byte-transparent")
+
+
+@contextlib.contextmanager
+def backend(emu, directory, api=True):
+    path = Path(directory)
+    uart = path / "uart.sock"
+    bus = path / "api.sock"
+    args = [str(emu), "--uart-socket", str(uart), "--start-held",
+            "-minions", "1", "-single_thread", "-reset_pc", hex(CODE)]
+    if api:
+        args += ["--api-socket", str(bus)]
+    log_path = path / "emu.log"
+    with log_path.open("wb") as log:
+        proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=log)
+        client = None
+        try:
+            until(lambda: proc.poll() is not None or uart.exists(), "UART listener")
+            check(proc.poll() is None, "backend exited before listener startup")
+            if api:
+                client = ErbClient(str(bus))
+                client.sock.settimeout(DEADLINE)
+            yield client, uart, proc
+            check(proc.poll() is None, "backend exited during serial service")
+        except BaseException:
+            log.flush()
+            print(log_path.read_text(errors="replace")[-12000:], file=sys.stderr)
+            raise
+        finally:
+            if client:
+                client.close()
+            if proc.poll() is None:
+                proc.terminate()
+            try:
+                proc.wait(timeout=DEADLINE)
+            except subprocess.TimeoutExpired:
+                proc.kill()
+                proc.wait()
+                raise AssertionError("backend failed to terminate/clean up")
+            check(proc.returncode == 0, f"backend return code {proc.returncode}")
+            check(not uart.exists(), "owned UART socket not removed at shutdown")
+            if api:
+                check(not bus.exists(), "API socket not removed at shutdown")
+            log.flush()
+            text = log_path.read_bytes()
+            check(b"FATAL" not in text and b"fatal error in chip model" not in text,
+                  "backend reported a fatal model error")
+            check(b"UART-no-stdout!" not in text, "disconnected serial output leaked into emulator logs")
+
+
+def exercise(emu):
+    with tempfile.TemporaryDirectory(prefix="erbium-uart-endpoint-") as tmp:
+        with backend(emu, tmp) as (client, path, _):
+            enable_pads(client)
+            peer = connect(path)
+            try:
+                # Full duplex, burst >16, all values including NUL, LF, CR,
+                # high-bit bytes, escape, and the xSPI framing magic.
+                payload = bytes(range(256)) + b"UERB\r\n\x1b\x00"
+                peer.sendall(payload)
+                serial_tx(client, peer, payload[::-1])
+                serial_rx(client, payload)
+                check(client.ping()[0] == 0, "UART traffic damaged xSPI protocol")
+
+                extra = connect(path)
+                try:
+                    check(extra.recv(1) == b"", "second serial client was not rejected")
+                finally:
+                    extra.close()
+                serial_tx(client, peer, b"retained-first-client")
+
+                # Target-only resets never close/recreate the serial connection.
+                w32(client, BAUD, 0x1234)
+                peer.sendall(b"warm-state")
+                until(lambda: u32(client, STATUS) & 4, "RX queued before warm reset")
+                w32(client, SOFT_RESET, 6)
+                check(u32(client, BAUD) & 0xFFFF == 0x1234, "CPU warm reset reset UART registers")
+                serial_rx(client, b"warm-state")
+                serial_tx(client, peer, b"held-warm-reset")
+                peer.sendall(b"POR-state")
+                until(lambda: u32(client, STATUS) & 4, "RX queued before POR")
+                check(client.reset(0) == 0, "POR failed")
+                check(u32(client, BAUD) & 0xFFFF == 5, "POR did not reset UART registers")
+                check(not (u32(client, STATUS) & 4), "POR did not reset internal UART RX FIFO")
+                enable_pads(client)  # POR disables the pinmux
+                serial_tx(client, peer, b"same-peer-after-POR")
+
+                # A real hart reaches WFI; peripheral serial service remains
+                # live without any UART/timer interrupt enabled.
+                code = struct.pack("<6I", 0x400102B7, 0x06500313, 0x0062B023,
+                                   0x30405073, 0x10500073, 0xFFDFF06F)
+                check(client.write(CODE, code) == 0, "upload WFI program")
+                check(client.write(MINION_BOOT, struct.pack("<Q", CODE)) == 0, "set boot PC")
+                w32(client, SOFT_RESET, 4)
+                until(lambda: read(client, SENTINEL, 8) == struct.pack("<Q", 101),
+                      "hart executes uploaded WFI program")
+                time.sleep(0.05)
+                peer.sendall(b"WFI-input")
+                serial_rx(client, b"WFI-input")
+                serial_tx(client, peer, b"WFI-output")
+                w32(client, SOFT_RESET, 6)
+            finally:
+                peer.close()
+
+            # No client must NOT fall back to stdout. Fill exactly the bounded
+            # UART FIFO while detached and deliver its retained bytes on reattach.
+            time.sleep(0.1)
+            deferred = b"UART-no-stdout!\x00"
+            check(len(deferred) == 16, "test requires exactly one UART FIFO")
+            for byte in deferred:
+                w32(client, TX, byte)
+            check(u32(client, STATUS) & 2, "disconnected TX did not retain bounded FIFO")
+            peer = connect(path)
+            try:
+                check(receive(peer, 16) == deferred, "reconnect lost queued UART TX")
+                peer.sendall(b"\x00\xffreconnected")
+                serial_rx(client, b"\x00\xffreconnected")
+                # Half-close ends this full-duplex session and allows replacement.
+                peer.shutdown(socket.SHUT_WR)
+                check(peer.recv(1) == b"", "half-close did not end serial session")
+            finally:
+                peer.close()
+            peer = connect(path)
+            try:
+                serial_tx(client, peer, b"reconnect-after-half-close")
+            finally:
+                peer.close()
+
+    # UART-only CPU-held operation also keeps serving/cleans up gracefully.
+    with tempfile.TemporaryDirectory(prefix="erbium-uart-only-") as tmp:
+        with backend(emu, tmp, api=False) as (_, path, _):
+            peer = connect(path)
+            try:
+                peer.sendall(b"held-without-xspi")
+                time.sleep(0.05)
+            finally:
+                peer.close()
+
+
+def cli_conflicts(emu):
+    with tempfile.TemporaryDirectory(prefix="erbium-uart-cli-") as tmp:
+        path = str(Path(tmp) / "uart.sock")
+        cases = [
+            ["--uart-socket", path, "--uart_rx_file", "/dev/null"],
+            ["--uart_tx_file", "/dev/null", "--uart-socket", path],
+            ["--uart-socket", path, "--api-socket", path],
+            ["--uart-socket", path, "--api-socket", f"{tmp}/./uart.sock"],
+            ["--uart-socket", path, "--uart_socket", path],
+            ["--uart-socket", ""],
+        ]
+        for args in cases:
+            proc = subprocess.run([str(emu), *args], stdin=subprocess.DEVNULL,
+                                  capture_output=True, timeout=DEADLINE)
+            check(proc.returncode != 0, f"conflicting CLI accepted: {args}")
+            check(b"--uart-socket" in proc.stdout, "UART option missing from help")
+            check(not Path(path).exists(), "CLI failure left a socket behind")
+
+        Path(path).write_bytes(b"preserve-this-unrelated-file")
+        proc = subprocess.run([str(emu), "--uart-socket", path, "--start-held"],
+                              stdin=subprocess.DEVNULL, capture_output=True, timeout=DEADLINE)
+        check(proc.returncode != 0, "existing unrelated path accepted")
+        check(Path(path).read_bytes() == b"preserve-this-unrelated-file",
+              "unrelated file was removed/modified")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--emu", required=True, type=Path)
+    args = parser.parse_args()
+    emu = args.emu.resolve()
+    cli_conflicts(emu)
+    exercise(emu)
+    print("UART endpoint integration: PASS")
+
+
+if __name__ == "__main__":
+    main()
