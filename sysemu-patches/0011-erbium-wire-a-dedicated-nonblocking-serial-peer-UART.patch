--- /dev/null
+++ b/sw-sysemu/tests/erbium/host/test_uart_socket.cpp
@@ -0,0 +1,219 @@
+/*-------------------------------------------------------------------------
+* Copyright (c) 2026 Ainekko, Co.
+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+// Isolated transport/lifecycle test. Compile with uart_socket.cpp; no emulator
+// library, cross compiler, or guest image is needed (see uart_socket.md).
+#include "uart_socket.h"
+
+#include <array>
+#include <cassert>
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace {
+struct Borrower {
+    int fd = -1;
+    int cached_fd = -1;
+    std::vector<int> attachments;
+    void attach(int new_fd) {
+        if (new_fd < 0) {
+            // Model the UART fdinterface poll: cached state must be cleared
+            // while the old borrowed fd is still open.
+            if (fd >= 0) assert(::fcntl(fd, F_GETFD) >= 0);
+            fd = cached_fd = -1;
+        } else {
+            assert(fd == -1 && cached_fd == -1);
+            assert(::fcntl(new_fd, F_GETFL) & O_NONBLOCK);
+            assert(::fcntl(new_fd, F_GETFD) & FD_CLOEXEC);
+            fd = cached_fd = new_fd;
+        }
+        attachments.push_back(new_fd);
+    }
+};
+
+int connect_peer(const std::string& path) {
+    int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    assert(fd >= 0);
+    struct sockaddr_un addr{};
+    addr.sun_family = AF_UNIX;
+    std::strcpy(addr.sun_path, path.c_str());
+    assert(::connect(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) == 0);
+    return fd;
+}
+
+void reject_path(const std::string& path) {
+    bool rejected = false;
+    try { UartSocket endpoint(path, [](int) {}); }
+    catch (const std::exception&) { rejected = true; }
+    assert(rejected);
+}
+
+size_t fd_count() {
+    size_t count = 0;
+    for (const auto& entry : std::filesystem::directory_iterator("/proc/self/fd")) {
+        (void)entry;
+        ++count;
+    }
+    return count;
+}
+} // namespace
+
+int main() {
+    char dir[] = "/tmp/uart-socket-test-XXXXXX";
+    assert(::mkdtemp(dir));
+    const std::string path = std::string(dir) + "/uart.sock";
+    assert(UartSocket::same_path(path, std::string(dir) + "/./uart.sock"));
+    assert(!UartSocket::same_path(path, std::string(dir) + "/api.sock"));
+    const auto initial_fd_count = fd_count();
+    struct sigaction before_pipe{}, before_term{};
+    assert(::sigaction(SIGPIPE, nullptr, &before_pipe) == 0);
+    assert(::sigaction(SIGTERM, nullptr, &before_term) == 0);
+    Borrower uart;
+    {
+        UartSocket endpoint(path, [&](int fd) { uart.attach(fd); });
+        assert(uart.fd == -1);
+        struct stat original{}, after{};
+        assert(::lstat(path.c_str(), &original) == 0);
+        reject_path(path); // live listener cannot be displaced
+        assert(::lstat(path.c_str(), &after) == 0);
+        assert(original.st_ino == after.st_ino);
+        struct sigaction current_pipe{};
+        assert(::sigaction(SIGPIPE, nullptr, &current_pipe) == 0);
+        assert(current_pipe.sa_handler == before_pipe.sa_handler);
+
+        int peer = connect_peer(path);
+        endpoint.process();
+        assert(endpoint.has_client());
+        const int original_fd = uart.fd;
+
+        std::array<unsigned char, 256> bytes{}, received{};
+        for (size_t i = 0; i < bytes.size(); ++i) bytes[i] = static_cast<unsigned char>(i);
+        assert(::send(peer, bytes.data(), bytes.size(), MSG_NOSIGNAL) == 256);
+        endpoint.process(); // lifecycle service must not consume any raw byte
+        assert(::read(uart.fd, received.data(), received.size()) == 256);
+        assert(bytes == received);
+        assert(::send(uart.fd, bytes.data(), bytes.size(), MSG_NOSIGNAL) == 256);
+        assert(::read(peer, received.data(), received.size()) == 256);
+        assert(bytes == received);
+
+        int extra = connect_peer(path);
+        endpoint.process();
+        assert(uart.fd == original_fd);
+        unsigned char byte;
+        assert(::read(extra, &byte, 1) == 0);
+        ::close(extra);
+
+        // Readable host bytes with no UART consumer must not make idle_wait
+        // spin. RX full/pinmux disabled are common causes in the real model.
+        assert(::send(peer, bytes.data(), bytes.size(), MSG_NOSIGNAL) == 256);
+        const auto start = std::chrono::steady_clock::now();
+        for (unsigned i = 0; i < 10; ++i) endpoint.idle_wait();
+        assert(std::chrono::steady_clock::now() - start >= std::chrono::milliseconds(5));
+        assert(::read(uart.fd, received.data(), received.size()) == 256);
+
+        // A slow reader cannot block the emulator's borrowed TX descriptor.
+        std::array<unsigned char, 16384> block{};
+        size_t sent = 0;
+        while (true) {
+            const auto n = ::send(uart.fd, block.data(), block.size(), MSG_NOSIGNAL);
+            if (n < 0) {
+                assert(errno == EAGAIN || errno == EWOULDBLOCK);
+                break;
+            }
+            sent += static_cast<size_t>(n);
+            assert(sent < 16 * 1024 * 1024);
+        }
+        ::close(peer);
+        endpoint.process();
+        assert(!endpoint.has_client() && uart.fd == -1 && uart.cached_fd == -1);
+        assert(::fcntl(original_fd, F_GETFD) < 0 && errno == EBADF);
+
+        peer = connect_peer(path);
+        endpoint.process();
+        assert(endpoint.has_client());
+        // Usually the number is reused; correctness cannot depend on that.
+        assert(::send(peer, bytes.data(), bytes.size(), MSG_NOSIGNAL) == 256);
+        assert(::read(uart.fd, received.data(), received.size()) == 256);
+        assert(received == bytes);
+        assert(::shutdown(peer, SHUT_WR) == 0);
+        endpoint.process();
+        assert(!endpoint.has_client());
+        ::close(peer);
+
+        // Shutdown is graceful for UART-only runs; destructor owns cleanup.
+        assert(!endpoint.stop_requested());
+        assert(::raise(SIGTERM) == 0);
+        assert(endpoint.stop_requested());
+    }
+    assert(!std::filesystem::exists(path));
+    struct sigaction after_term{};
+    assert(::sigaction(SIGTERM, nullptr, &after_term) == 0);
+    assert(after_term.sa_handler == before_term.sa_handler);
+
+    // Refuse unrelated files, symlinks, and stale sockets; never unlink them.
+    std::ofstream(path) << "keep";
+    for (unsigned i = 0; i < 20; ++i) reject_path(path);
+    assert(std::filesystem::file_size(path) == 4);
+    ::unlink(path.c_str());
+    assert(::symlink("missing-target", path.c_str()) == 0);
+    reject_path(path);
+    assert(std::filesystem::is_symlink(path));
+    ::unlink(path.c_str());
+    {
+        int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+        assert(fd >= 0);
+        struct sockaddr_un addr{};
+        addr.sun_family = AF_UNIX;
+        std::strcpy(addr.sun_path, path.c_str());
+        assert(::bind(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) == 0);
+        ::close(fd);
+        reject_path(path);
+        assert(std::filesystem::exists(path));
+        ::unlink(path.c_str());
+    }
+    reject_path("");
+    reject_path(std::string(108, 'x'));
+
+    // A replacement at the old pathname is not ours to unlink on shutdown.
+    {
+        UartSocket endpoint(path, [](int) {});
+        ::unlink(path.c_str());
+        std::ofstream(path) << "replacement";
+    }
+    assert(std::filesystem::file_size(path) == 11);
+    ::unlink(path.c_str());
+
+    // Likewise preserve a different live listener replacing our pathname.
+    int replacement = -1;
+    {
+        UartSocket endpoint(path, [](int) {});
+        assert(::unlink(path.c_str()) == 0);
+        replacement = ::socket(AF_UNIX, SOCK_STREAM, 0);
+        assert(replacement >= 0);
+        struct sockaddr_un addr{};
+        addr.sun_family = AF_UNIX;
+        std::strcpy(addr.sun_path, path.c_str());
+        assert(::bind(replacement, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) == 0);
+        assert(::listen(replacement, 1) == 0);
+    }
+    assert(std::filesystem::exists(path));
+    const int peer = connect_peer(path);
+    ::close(peer);
+    ::close(replacement);
+    ::unlink(path.c_str());
+    ::rmdir(dir);
+    assert(fd_count() == initial_fd_count);
+    std::cout << "UART socket lifecycle: PASS\n";
+}
