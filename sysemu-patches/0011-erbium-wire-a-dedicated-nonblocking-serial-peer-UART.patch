diff --git a/sw-sysemu/sys_emu/uart_socket.cpp b/sw-sysemu/sys_emu/uart_socket.cpp
new file mode 100644
index 0000000..bb074fc
--- /dev/null
+++ b/sw-sysemu/sys_emu/uart_socket.cpp
@@ -0,0 +1,184 @@
+/*-------------------------------------------------------------------------
+* Copyright (c) 2026 Ainekko, Co.
+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+
+#include "uart_socket.h"
+
+#include <cerrno>
+#include <cstring>
+#include <stdexcept>
+#include <system_error>
+#include <utility>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace {
+volatile sig_atomic_t uart_stop_requested = 0;
+void stop_uart(int) { uart_stop_requested = 1; }
+
+void fail(const char* operation)
+{
+    throw std::system_error(errno, std::generic_category(), operation);
+}
+} // namespace
+
+UartSocket::UartSocket(const std::string& path, Attach attach)
+    : path_(path), attach_(std::move(attach))
+{
+    struct sockaddr_un addr{};
+    if (path.empty() || path.size() >= sizeof(addr.sun_path) ||
+        path.find('\0') != std::string::npos) {
+        throw std::invalid_argument("UART socket: invalid or overlong pathname");
+    }
+    addr.sun_family = AF_UNIX;
+    std::memcpy(addr.sun_path, path.c_str(), path.size() + 1);
+
+    try {
+        listen_fd_ = ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        if (listen_fd_ < 0) fail("UART socket");
+        // Never remove an existing path, even a stale socket. In particular,
+        // binding another emulator must not displace a live listener.
+        if (::bind(listen_fd_, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) < 0)
+            fail("UART socket bind (path must not already exist)");
+        struct stat st{};
+        if (::lstat(path_.c_str(), &st) < 0) fail("UART socket lstat");
+        if (!S_ISSOCK(st.st_mode))
+            throw std::runtime_error("UART socket pathname changed during bind");
+        path_dev_ = st.st_dev;
+        path_ino_ = st.st_ino;
+        owns_path_ = true;
+        if (::listen(listen_fd_, 1) < 0) fail("UART socket listen");
+
+        // Keep cleanup effective for UART-only runs as well as API runs.
+        // Restore prior handlers on destruction; do not globally ignore
+        // SIGPIPE (the UART FD writer suppresses its own write's signal).
+        struct sigaction sa{};
+        sa.sa_handler = stop_uart;
+        ::sigemptyset(&sa.sa_mask);
+        uart_stop_requested = 0;
+        if (::sigaction(SIGINT, &sa, &old_int_) < 0) fail("UART SIGINT");
+        installed_int_ = true;
+        if (::sigaction(SIGTERM, &sa, &old_term_) < 0) fail("UART SIGTERM");
+        installed_term_ = true;
+        attach_(-1);
+    } catch (...) {
+        cleanup();
+        throw;
+    }
+}
+
+UartSocket::~UartSocket()
+{
+    cleanup();
+}
+
+void UartSocket::drop_client()
+{
+    if (client_fd_ < 0) return;
+    // Invalidate the borrowed fd and its UART cache BEFORE closing it. The
+    // next accepted connection can have exactly the same descriptor number.
+    attach_(-1);
+    ::close(client_fd_);
+    client_fd_ = -1;
+}
+
+void UartSocket::cleanup()
+{
+    drop_client();
+    if (listen_fd_ >= 0) {
+        ::close(listen_fd_);
+        listen_fd_ = -1;
+    }
+    // Do not unlink a replacement file/socket installed at our old pathname.
+    struct stat st{};
+    if (owns_path_ && ::lstat(path_.c_str(), &st) == 0 &&
+        S_ISSOCK(st.st_mode) && st.st_dev == path_dev_ && st.st_ino == path_ino_) {
+        ::unlink(path_.c_str());
+    }
+    owns_path_ = false;
+    if (installed_term_) ::sigaction(SIGTERM, &old_term_, nullptr);
+    if (installed_int_) ::sigaction(SIGINT, &old_int_, nullptr);
+    installed_term_ = installed_int_ = false;
+}
+
+bool UartSocket::stop_requested() const
+{
+    return uart_stop_requested != 0;
+}
+
+bool UartSocket::same_path(const std::string& a, const std::string& b)
+{
+    if (a.empty() || b.empty()) return false;
+    if (a == b) return true;
+    const auto split = [](const std::string& path) {
+        const auto slash = path.find_last_of('/');
+        if (slash == std::string::npos) return std::make_pair(std::string("."), path);
+        return std::make_pair(slash == 0 ? std::string("/") : path.substr(0, slash),
+                              path.substr(slash + 1));
+    };
+    const auto first = split(a);
+    const auto second = split(b);
+    if (first.second != second.second) return false;
+    struct stat left{}, right{};
+    return ::stat(first.first.c_str(), &left) == 0 &&
+           ::stat(second.first.c_str(), &right) == 0 &&
+           left.st_dev == right.st_dev && left.st_ino == right.st_ino;
+}
+
+void UartSocket::process()
+{
+    struct pollfd fds[] = {
+        {listen_fd_, POLLIN, 0},
+        {client_fd_, POLLRDHUP, 0},
+    };
+    int rv = ::poll(fds, 2, 0);
+    if (rv < 0) {
+        if (errno == EINTR) return;
+        fail("UART socket poll");
+    }
+    if (client_fd_ >= 0) {
+        const auto events = fds[1].revents;
+        if (events & (POLLERR | POLLHUP | POLLRDHUP | POLLNVAL)) {
+            drop_client();
+        }
+    }
+    if (!(fds[0].revents & POLLIN)) return;
+    // Bounded work under connect storms. One live client is retained; extra
+    // clients are accepted and immediately closed, never queued for takeover.
+    for (unsigned i = 0; i < 16; ++i) {
+        const int fd = ::accept4(listen_fd_, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+        if (fd < 0) {
+            // Interrupted/transient accepts will be retried next iteration;
+            // resource exhaustion must not stall CPU execution either.
+            return;
+        }
+        if (client_fd_ >= 0) {
+            ::close(fd);
+            continue;
+        }
+        try {
+            attach_(fd);
+        } catch (...) {
+            attach_(-1);
+            ::close(fd);
+            throw;
+        }
+        client_fd_ = fd;
+    }
+}
+
+void UartSocket::idle_wait()
+{
+    // Do not wait on POLLOUT (usually always ready) or client POLLIN: a full
+    // UART FIFO/pinmux-disabled receiver can leave readable bytes indefinitely.
+    // A bounded 1ms sleep still services incoming serial data while held/WFI,
+    // without spinning on host backpressure. Timers bypass this in sys_emu.
+    // A listener can also remain readable under accept resource exhaustion.
+    // Always yield here; the next process() is at most 1ms away.
+    if (::poll(nullptr, 0, 1) < 0 && errno != EINTR) fail("UART socket idle poll");
+}
