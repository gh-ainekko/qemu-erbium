diff --git a/sw-sysemu/memory/mmap_region.h b/sw-sysemu/memory/mmap_region.h
new file mode 100644
index 0000000..07f1846
--- /dev/null
+++ b/sw-sysemu/memory/mmap_region.h
@@ -0,0 +1,132 @@
+/*-------------------------------------------------------------------------
+* Copyright (c) 2026 Ainekko, Co.
+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+
+#ifndef BEMU_MMAP_REGION_H
+#define BEMU_MMAP_REGION_H
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <ostream>
+#include <stdexcept>
+#include <string>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "memory/memory_error.h"
+#include "memory/memory_region.h"
+
+namespace bemu {
+
+
+// A memory region backed by a MAP_SHARED mapping of a file. Used to share
+// non-volatile memory (Erbium MRAM) with another process, e.g. a QEMU
+// memory-backend-file with share=on.
+//
+// The file is created if it does not exist and grown to the region size if
+// it is smaller; an existing file is never truncated, so the contents
+// survive an emulator reset (the region object is re-created on
+// MainMemory::reset(), which simply unmaps and re-maps the same file).
+//
+// The reset pattern (-mem_reset) does not apply: the region exposes the file
+// contents as-is, like real non-volatile memory would.
+template<unsigned long long Base, unsigned long long N, bool Writeable=true>
+struct MmapRegion : public MemoryRegion {
+    using addr_type     = typename MemoryRegion::addr_type;
+    using size_type     = typename MemoryRegion::size_type;
+    using value_type    = typename MemoryRegion::value_type;
+    using pointer       = typename MemoryRegion::pointer;
+    using const_pointer = typename MemoryRegion::const_pointer;
+
+    static_assert(!(Base % 64),
+                  "bemu::MmapRegion must be aligned to 64");
+    static_assert((N > 0) && !(N % 64),
+                  "bemu::MmapRegion size must be a multiple of 64");
+
+    explicit MmapRegion(const std::string& path)
+        : path_(path)
+    {
+        int fd = ::open(path.c_str(), (Writeable ? O_RDWR : O_RDONLY) | O_CREAT | O_CLOEXEC, 0666);
+        if (fd < 0) {
+            throw std::runtime_error("bemu::MmapRegion: cannot open '" + path + "': " + std::strerror(errno));
+        }
+        struct stat st;
+        if (::fstat(fd, &st) != 0) {
+            int err = errno;
+            ::close(fd);
+            throw std::runtime_error("bemu::MmapRegion: fstat '" + path + "': " + std::strerror(err));
+        }
+        if (static_cast<unsigned long long>(st.st_size) < N) {
+            if (!Writeable || ::ftruncate(fd, static_cast<off_t>(N)) != 0) {
+                int err = errno;
+                ::close(fd);
+                throw std::runtime_error("bemu::MmapRegion: cannot grow '" + path + "' to " +
+                                         std::to_string(N) + " bytes: " + std::strerror(err));
+            }
+        }
+        void* p = ::mmap(nullptr, N, PROT_READ | (Writeable ? PROT_WRITE : 0), MAP_SHARED, fd, 0);
+        ::close(fd);
+        if (p == MAP_FAILED) {
+            throw std::runtime_error("bemu::MmapRegion: mmap '" + path + "': " + std::strerror(errno));
+        }
+        data_ = static_cast<pointer>(p);
+    }
+
+    ~MmapRegion() override {
+        if (data_) {
+            ::munmap(data_, N);
+        }
+    }
+
+    MmapRegion(const MmapRegion&) = delete;
+    MmapRegion& operator=(const MmapRegion&) = delete;
+
+    void read(const Agent&, size_type pos, size_type n, pointer result) override {
+        std::copy_n(data_ + pos, n, result);
+    }
+
+    void write(const Agent& agent, size_type pos, size_type n, const_pointer source) override {
+        if (!Writeable)
+            throw memory_error(first() + pos);
+        init(agent, pos, n, source);
+    }
+
+    void init(const Agent&, size_type pos, size_type n, const_pointer source) override {
+        std::copy_n(source, n, data_ + pos);
+    }
+
+    addr_type first() const override { return Base; }
+    addr_type last() const override { return Base + N - 1; }
+
+    void dump_data(const Agent&, std::ostream& os, size_type pos, size_type n) const override {
+        size_type m = (pos >= N) ? 0 : std::min(n, N - pos);
+        if (m > 0) {
+            os.write(reinterpret_cast<const char*>(data_ + pos), m);
+            n -= m;
+        }
+        const char zero = 0;
+        while (n-- > 0)
+            os.write(&zero, 1);
+    }
+
+    // Flush dirty pages to the file (not required for sharing with another
+    // process mapping the same file, only for durability).
+    void sync() const {
+        ::msync(data_, N, MS_SYNC);
+    }
+
+    const std::string& path() const { return path_; }
+    pointer data() { return data_; }
+
+private:
+    std::string path_;
+    pointer     data_ = nullptr;
+};
+
+
+} // namespace bemu
+
+#endif // BEMU_MMAP_REGION_H
