+* SPDX-License-Identifier: Apache-2.0
+*-------------------------------------------------------------------------*/
+
+#ifndef BEMU_SCCR_ER_H
+#define BEMU_SCCR_ER_H
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <ostream>
+#include <stdexcept>
+#include "memory/memory_error.h"
+#include "memory/memory_region.h"
+
+namespace bemu {
+
+
+// Stub for the xSPI target IP "Status and Control Registers" (SCCR) block
+// at ERBIUM_TOP_XSPI_REGISTERS_BASE.
+//
+// The real SCCR behaviour (setRate, WIP, AXI-error reporting, ...) lives on
+// the host/xSPI side (QEMU's erbium-xspi device). This region only exists
+// so that minion firmware touching e.g. xspi_control.interrupt_enable does
+// not hit a memory_error: every register is plain 64-bit-stride storage
+// with the documented reset values.
+//
+// Register map (TRM SCCR_Reg, 64-bit stride, size 0x38):
+//   0x00 ID0              reset 0x2 (mgf_id=2)
+//   0x08 ID1              reset 0x0
+//   0x10 CFG              reset 0x1382 (BurstLength=2, FixedLatency=1,
+//                                       InitialLatency=8, Reserved(11:8)=1,
+//                                       DriveStrength=3)
+//   0x18 xspi_status      reset 0x0
+//   0x20 xspi_control     reset 0x0
+//   0x28 xspi_rates       reset 0x0
+//   0x30 interrupt_status reset 0x0
+//
+// Note: hwinc/top.h sizes the block at 0x1C; the TRM map is 0x38 with 64-bit
+// registers. We cover 0x40 bytes (8 x 64-bit slots, the last one unused).
+template <unsigned long long Base>
+struct SccrEr : public MemoryRegion {
+    using addr_type     = typename MemoryRegion::addr_type;
+    using size_type     = typename MemoryRegion::size_type;
+    using value_type    = typename MemoryRegion::value_type;
+    using pointer       = typename MemoryRegion::pointer;
+    using const_pointer = typename MemoryRegion::const_pointer;
+
+    static constexpr size_type   SIZE      = 0x40;
+    static constexpr unsigned    NUM_REGS  = SIZE / 8;
+
+    static constexpr size_type ID0              = 0x00;
+    static constexpr size_type ID1              = 0x08;
+    static constexpr size_type CFG              = 0x10;
+    static constexpr size_type XSPI_STATUS      = 0x18;
+    static constexpr size_type XSPI_CONTROL     = 0x20;
+    static constexpr size_type XSPI_RATES       = 0x28;
+    static constexpr size_type INTERRUPT_STATUS = 0x30;
+
+    static constexpr uint64_t ID0_RESET = 0x2;
+    static constexpr uint64_t CFG_RESET = 0x1382;
+
+    SccrEr() { reset(); }
+
+    void reset() {
+        regs.fill(0);
+        regs[ID0 / 8] = ID0_RESET;
+        regs[CFG / 8] = CFG_RESET;
+    }
+
+    void read(const Agent&, size_type pos, size_type n, pointer result) override {
+        check_access(pos, n);
+        std::memcpy(result, reinterpret_cast<const uint8_t*>(regs.data()) + pos, n);
+    }
+
+    void write(const Agent&, size_type pos, size_type n, const_pointer source) override {
+        check_access(pos, n);
+        std::memcpy(reinterpret_cast<uint8_t*>(regs.data()) + pos, source, n);
+    }
+
+    void init(const Agent&, size_type, size_type, const_pointer) override {
+        throw std::runtime_error("bemu::SccrEr::init()");
+    }
+
+    addr_type first() const override { return Base; }
+    addr_type last() const override { return Base + SIZE - 1; }
+
+    void dump_data(const Agent&, std::ostream&, size_type, size_type) const override { }
+
+    std::array<uint64_t, NUM_REGS> regs{};
+
+private:
+    // Registers are 32/64-bit oriented: accept naturally aligned 4- or 8-byte
+    // accesses that do not cross a 64-bit register boundary.
+    void check_access(size_type pos, size_type n) const {
+        if ((n != 4 && n != 8) || (pos % n) != 0 || (pos / 8) != ((pos + n - 1) / 8) || pos + n > SIZE)
+            throw memory_error(Base + pos);
+    }
+};
+
+
+} // namespace bemu
+
+#endif // BEMU_SCCR_ER_H
